{
  "name": "tree-sitter-weave",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Weave narrative scripting language",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisgliddon/weave.git",
    "directory": "tree-sitter-weave"
  },
  "license": "MIT",
  "author": {
    "name": "Weave Contributors"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "weave"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.12"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js test/*.test.mjs",
    "test:grammar": "tree-sitter test"
  }
}
