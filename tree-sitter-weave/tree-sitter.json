{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "weave",
      "camelcase": "Weave",
      "title": "Weave",
      "scope": "source.weave",
      "file-types": [
        "weave"
      ],
      "injection-regex": "^weave$",
      "class-name": "TreeSitterWeave",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Weave narrative scripting language",
    "authors": [
      {
        "name": "Weave Contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/chrisgliddon/weave"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
