{{- $pages := slice -}}
{{- range site.Pages -}}
  {{- if in (slice "home" "page") .Kind -}}
    {{- $url := .RelPermalink -}}
    {{- if .IsHome -}}{{- $url = "" | relURL -}}{{- end -}}
    {{- $pages = $pages | append (dict
        "title" (partial "page-title.html" .)
        "url" $url
        "text" (.Plain | truncate 4000)) -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
