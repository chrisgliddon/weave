      }
    },
    "AttributeAdjustments": {
      "kind": "object",
      "fields": {
        "agility": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -6.0,
            "maximum": 6.0
          },
          "required": true,
          "description": "Agility adjustment."
        },
        "brains": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -6.0,
            "maximum": 6.0
          },
          "required": true,
          "description": "Brains adjustment."
        },
        "brawn": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -6.0,
            "maximum": 6.0
          },
          "required": true,
          "description": "Brawn adjustment."
        },
        "wits": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -6.0,
            "maximum": 6.0
          },
          "required": true,
          "description": "Wits adjustment."
        }
      }
    },
    "Attributes": {
      "kind": "object",
      "fields": {
        "agility": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 12.0
          },
          "required": true,
          "description": "Effective Agility rating."
        },
        "brains": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 12.0
          },
          "required": true,
          "description": "Effective Brains rating."
        },
        "brawn": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 12.0
          },
          "required": true,
          "description": "Effective Brawn rating."
        },
        "wits": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 12.0
          },
          "required": true,
          "description": "Effective Wits rating."
        }
      }
    },
    "ChaseRound": {
      "kind": "object",
