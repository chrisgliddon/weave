      "jammed_items": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "string",
            "min_length": 1,
            "max_length": 120
          },
          "min_items": 0,
          "max_items": 64
        },
        "required": true,
        "description": "Ranged items jammed by a fumble."
      },
      "last_operation": {
        "type": {
          "kind": "string",
          "min_length": 0,
          "max_length": 128
        },
        "required": true,
        "description": "Most recently resolved operation."
      },
      "survivability_current": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 0.0,
          "maximum": 18.0
        },
        "required": true,
        "description": "Current Survivability."
      },
      "wounded": {
        "type": {
          "kind": "bool"
        },
        "required": true,
        "description": "Wounded state at zero Survivability."
      }
    }
  },
  "creation_steps": [
    {
      "id": "identity",
      "title": "Character identity",
      "description": "Enter an original fictional name and age; these values are never inferred from the canonical Character profile.",
      "required_capability": "character_creation",
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "description": "Explicit adapter-owned Name input.",
          "value_type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 160
          },
          "required": true,
          "authority": "adapter_owned"
        },
        {
          "id": "age",
          "label": "Age",
          "description": "Explicit adapter-owned Age input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 300.0
          },
          "required": true,
          "authority": "adapter_owned"
        }
      ]
    },
    {
      "id": "ratings",
      "title": "Ratings",
      "description": "Choose deterministic rolled creation or explicit ratings, then inspect both roll sets, their seed lineage, and the selected assignment before accepting.",
      "required_capability": "character_creation",
      "fields": [
        {
          "id": "creation_mode",
          "label": "Creation mode",
          "description": "Explicit adapter-owned Creation mode input.",
          "value_type": {
            "kind": "symbol",
            "values": [
              "authored",
              "rolled"
            ]
          },
          "required": true,
          "authority": "adapter_owned"
        },
        {
          "id": "seed",
          "label": "Seed",
          "description": "Explicit adapter-owned Seed input.",
          "value_type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 20
          },
          "required": true,
          "authority": "adapter_owned"
        },
        {
          "id": "agility",
          "label": "Agility",
          "description": "Explicit adapter-owned Agility input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 6.0
          },
          "required": false,
          "authority": "adapter_owned"
        },
        {
          "id": "brains",
          "label": "Brains",
          "description": "Explicit adapter-owned Brains input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 6.0
          },
          "required": false,
          "authority": "adapter_owned"
        },
        {
          "id": "brawn",
          "label": "Brawn",
          "description": "Explicit adapter-owned Brawn input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 6.0
          },
          "required": false,
          "authority": "adapter_owned"
        },
        {
          "id": "wits",
          "label": "Wits",
          "description": "Explicit adapter-owned Wits input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 6.0
          },
          "required": false,
          "authority": "adapter_owned"
        },
        {
          "id": "fortune",
          "label": "Fortune",
          "description": "Explicit adapter-owned Fortune input.",
          "value_type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 3.0
          },
          "required": false,
          "authority": "adapter_owned"
        }
      ]
    },
    {
      "id": "survivability",
      "title": "Survivability",
      "description": "Choose one physical rating plus one rounded-up half mental rating; the derived value is recomputed and cannot be authored directly.",
      "required_capability": "derived_values",
      "fields": [
        {
          "id": "survivability_body",
          "label": "Physical basis",
          "description": "Explicit adapter-owned Physical basis input.",
          "value_type": {
            "kind": "symbol",
            "values": [
              "agility",
              "brawn"
            ]
          },
          "required": true,
          "authority": "adapter_owned"
        },
        {
          "id": "survivability_mind",
          "label": "Mental basis",
          "description": "Explicit adapter-owned Mental basis input.",
          "value_type": {
            "kind": "symbol",
            "values": [
              "brains",
              "wits"
            ]
          },
          "required": true,
          "authority": "adapter_owned"
        }
      ]
    },
    {
      "id": "details",
      "title": "Balanced modifiers and inventory",
      "description": "Add exactly two independently described zero-sum modifiers and an explicit bounded inventory.",
      "required_capability": "character_creation",
      "fields": [
        {
          "id": "modifiers",
          "label": "Two modifiers",
          "description": "Explicit adapter-owned Two modifiers input.",
          "value_type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "Modifier"
            },
            "min_items": 2,
            "max_items": 2
          },
          "required": true,
          "authority": "adapter_owned"
        },
        {
          "id": "inventory",
          "label": "Inventory",
          "description": "Explicit adapter-owned Inventory input.",
          "value_type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 120
            },
            "min_items": 0,
            "max_items": 64
          },
          "required": true,
          "authority": "adapter_owned"
        }
      ]
    }
  ],
  "operations": {
    "attack": {
      "id": "attack",
      "title": "Resolve an attack",
      "description": "Resolve a weapon or unarmed attack against explicit target Survivability, including critical damage, melee self-harm, ranged jams, and wound state.",
      "required_capability": "checks_and_conflicts",
      "request_type": {
        "kind": "object",
        "fields": {
          "attribute": {
            "type": {
              "kind": "symbol",
              "values": [
                "agility",
                "brains",
                "brawn",
                "wits"
              ]
            },
            "required": true,
            "description": "Attack attribute."
          },
          "damage_die": {
            "type": {
              "kind": "number",
              "integer": true,
              "minimum": 1.0,
              "maximum": 20.0
            },
            "required": true,
            "description": "Maximum weapon damage."
          },
          "modifier": {
            "type": {
              "kind": "number",
              "integer": true,
              "minimum": -12.0,
              "maximum": 12.0
            },
            "required": true,
            "description": "Situational modifier."
          },
          "roll_mode": {
            "type": {
              "kind": "symbol",
              "values": [
                "advantage",
                "disadvantage",
                "normal"
              ]
            },
            "required": true,
            "description": "Normal, advantage, or disadvantage."
          },
          "target_survivability": {
            "type": {
              "kind": "number",
              "integer": true,
              "minimum": 0.0,
              "maximum": 18.0
            },
            "required": true,
            "description": "Target number met to hit."
          },
          "weapon_id": {
            "type": {
              "kind": "string",
              "min_length": 1,
              "max_length": 120
            },
            "required": true,
            "description": "Inventory item or `unarmed`."
          },
          "weapon_kind": {
            "type": {
              "kind": "symbol",
              "values": [
                "melee",
                "ranged",
                "unarmed"
              ]
            },
            "required": true,
            "description": "Weapon behavior."
          }
        }
      },
      "event_kinds": [
        "attack_resolved",
        "entropy_trace",
        "resource_changed"
      ],
      "consumes_entropy": true
    },
    "chase": {
