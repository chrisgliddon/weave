{
  "manifest_format_version": 1,
  "id": "org.weave.tabletop.plug_and_play",
  "version": "1.0.0",
  "schema_version": 1,
  "namespace": "plug_and_play",
  "title": "Plug-And-Play compatible adapter",
  "compatibility_label": "Compatible with the CC0 Plug-And-Play rules; not endorsed by its creator",
  "summary": "An independently implemented, deterministic adapter for quick d6 character creation, checks, Fortune, combat, group action, card initiative, and bounded chases.",
  "weave_version": ">=0.1.0, <0.2.0",
  "character_contract_version": ">=1.0.0, <2.0.0",
  "extension_surface": {
    "kind": "declarative_data_with_registered_resolver",
    "resolver_contract_version": 1
  },
  "capabilities": [
    {
      "capability": "character_creation",
      "version": 1
    },
    {
      "capability": "derived_values",
      "version": 1
    },
    {
      "capability": "checks_and_conflicts",
      "version": 1
    },
    {
      "capability": "resources_and_conditions",
      "version": 1
    },
    {
      "capability": "equipment_and_abilities",
      "version": 1
    },
    {
      "capability": "encounters",
      "version": 1
    }
  ],
  "types": {
