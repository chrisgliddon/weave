      "fortune_initial": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 0.0,
          "maximum": 6.0
        },
        "required": true,
        "description": "Fortune after balanced modifiers."
      },
      "inventory": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "string",
            "min_length": 1,
            "max_length": 120
          },
          "min_items": 0,
          "max_items": 64
        },
        "required": true,
        "description": "Initial carried item names."
      },
      "modifiers": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "named",
            "name": "Modifier"
          },
          "min_items": 2,
          "max_items": 2
        },
        "required": true,
        "description": "Exactly two balanced modifiers."
      },
      "name": {
        "type": {
          "kind": "string",
          "min_length": 1,
          "max_length": 160
        },
        "required": true,
        "description": "Explicit fictional display name."
      },
      "roll_sets": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "named",
            "name": "RollSet"
          },
          "min_items": 0,
          "max_items": 2
        },
        "required": true,
        "description": "Deterministic raw creation options."
      },
      "selected_set": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "required": false,
        "description": "Explicitly accepted rolled set."
      },
      "survivability": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 0.0,
          "maximum": 18.0
        },
        "required": true,
        "description": "Derived starting Survivability."
      },
      "survivability_body": {
        "type": {
          "kind": "symbol",
          "values": [
            "agility",
            "brawn"
          ]
        },
        "required": true,
        "description": "Whole physical contribution."
      },
      "survivability_mind": {
        "type": {
          "kind": "symbol",
          "values": [
            "brains",
            "wits"
          ]
        },
        "required": true,
        "description": "Rounded-up half mental contribution."
      }
    }
