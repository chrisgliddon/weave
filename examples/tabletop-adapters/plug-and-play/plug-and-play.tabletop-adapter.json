        },
        "player_total": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -32.0,
            "maximum": 64.0
          },
          "required": true,
          "description": "Player total."
        },
        "round": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 3.0
