            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 14.0
          },
          "required": true,
          "description": "Numeric rank; zero is a joker."
        },
        "suit": {
          "type": {
            "kind": "symbol",
            "values": [
              "clubs",
              "diamonds",
              "hearts",
              "joker",
              "spades"
            ]
          },
          "required": true,
          "description": "Portable suit identity."
        }
      }
    },
    "Modifier": {
      "kind": "object",
      "fields": {
        "attributes": {
          "type": {
            "kind": "named",
            "name": "AttributeAdjustments"
          },
          "required": true,
          "description": "Balanced regular-attribute adjustments."
        },
        "explanation": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 512
          },
          "required": true,
          "description": "Original author-facing adjustment explanation."
        },
        "fortune": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": -6.0,
            "maximum": 6.0
          },
          "required": true,
          "description": "Balanced Fortune adjustment."
        },
        "id": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Stable modifier identifier."
        },
        "label": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 160
          },
          "required": true,
          "description": "Author-facing modifier label."
        }
      }
    },
    "RollSet": {
      "kind": "object",
      "fields": {
        "d3": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 3.0
          },
          "required": true,
          "description": "Raw Fortune die result."
        },
        "d6": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "number",
              "integer": true,
              "minimum": 1.0,
              "maximum": 6.0
            },
            "min_items": 4,
            "max_items": 4
          },
          "required": true,
          "description": "Four assignable regular-attribute results."
        },
        "entropy_end": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 4294967295.0
          },
          "required": true,
          "description": "Cursor after this set."
        },
        "entropy_start": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 4294967295.0
          },
          "required": true,
          "description": "Cursor before this set."
        },
        "index": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "required": true,
          "description": "Creation set index."
        }
      }
    }
  },
  "definition_type": {
    "kind": "object",
    "fields": {
      "age": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 1.0,
          "maximum": 300.0
        },
        "required": true,
        "description": "Explicit fictional age."
      },
      "assignment": {
        "type": {
          "kind": "named",
          "name": "Assignment"
        },
        "required": false,
        "description": "Explicit assignment for rolled creation."
      },
      "base_attributes": {
        "type": {
          "kind": "named",
          "name": "Attributes"
        },
        "required": true,
        "description": "Unmodified accepted ratings."
      },
      "base_fortune": {
        "type": {
          "kind": "number",
          "integer": true,
          "minimum": 1.0,
          "maximum": 3.0
        },
        "required": true,
        "description": "Unmodified accepted Fortune rating."
      },
      "creation_mode": {
        "type": {
          "kind": "symbol",
          "values": [
            "authored",
            "rolled"
          ]
        },
        "required": true,
        "description": "Explicit creation mode."
      },
      "creation_seed": {
        "type": {
          "kind": "string",
          "min_length": 1,
          "max_length": 20
        },
        "required": true,
        "description": "Exact decimal deterministic seed."
      },
      "effective_attributes": {
        "type": {
          "kind": "named",
          "name": "Attributes"
        },
        "required": true,
        "description": "Ratings after both balanced modifiers."
