    "transformations": [
      {
        "id": "normalize_biomes",
        "inputs": [
          "resolve_ecoregions"
        ],
        "description": "Deduplicate reviewed ecoregion biome classes into the closed Weave World vocabulary and retain the contributor-selected primary narrative class."
      },
      {
        "id": "normalize_climate",
        "inputs": [
          "nasa_power_climate"
        ],
        "description": "Validate declared source units, convert daily precipitation rates to annual millimetres using the exact inclusive reference-period day count, form deterministic ranges, and rank monthly temperatures without interpolation."
      },
      {
        "id": "normalize_daylight",
        "inputs": [
          "nasa_power_climate",
          "natural_earth_land",
          "weave_world_fixture"
        ],
        "description": "Calculate idealized June and December solstice daylight from the declared representative WGS84 latitude and 23.44 degree solar declination, clamp polar results, and round to one decimal hour; atmospheric refraction, terrain, and twilight are excluded."
      },
      {
        "id": "normalize_hazards",
        "inputs": [
          "nasa_power_climate",
          "natural_earth_land",
          "natural_earth_ocean",
          "resolve_ecoregions",
          "weave_world_fixture"
        ],
        "description": "Apply corpus-v1 environmental thresholds only: annual precipitation at least 2000 mm, monthly freezing, wet mountain slopes, coastal atolls, and explicitly curated cyclone exposure. Results are tendencies, not event forecasts or risk scores."
      },
      {
        "id": "normalize_identity",
        "inputs": [
          "natural_earth_land",
          "weave_world_fixture"
        ],
        "description": "Bind the stable contributor-owned shorthand, display identity, country code, and geographic scope while requiring culture_included to remain false."
      },
      {
        "id": "normalize_terrain_water",
        "inputs": [
          "natural_earth_land",
          "natural_earth_ocean",
          "resolve_ecoregions",
          "weave_world_fixture"
        ],
        "description": "Reduce reviewed physical and ecoregion inputs to conservative closed terrain, coast, island-system, and water-setting categories."
      },
      {
        "id": "normalize_weather",
        "inputs": [
          "nasa_power_climate",
          "natural_earth_land",
          "natural_earth_ocean",
          "resolve_ecoregions",
          "weave_world_fixture"
        ],
        "description": "Reduce reviewed climate observations plus physical context to conservative closed weather tendencies; these are broad narrative cues, not forecasts."
      },
      {
        "id": "normalize_world_seed",
        "inputs": [
          "normalize_biomes",
          "normalize_climate",
          "normalize_daylight",
          "normalize_hazards",
          "normalize_identity",
          "normalize_terrain_water",
          "normalize_weather"
        ],
        "description": "Assemble one deterministic typed environmental WorldSeed with explicit attribution, scale, units, uncertainty, approximation, daylight, and hazard policy; no cultural traits are inferred."
      }
    ],
