{
  "contract_version": 1,
  "pack_format_version": 1,
  "id": "org.weave.world",
  "version": "1.1.0",
  "namespace": "world",
  "title": "Weave World",
  "summary": "Typed environmental reference seeds and stable authored layers for fictional world building.",
  "authors": [
    {
      "name": "Weave Contributors",
      "url": "https://github.com/chrisgliddon/weave"
    }
  ],
  "license": "MIT",
  "license_url": "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
  "weave_version": ">=0.1.0, <0.2.0",
  "capabilities": [
    {
      "id": "data",
      "version": 1
    },
    {
      "id": "editor_schema",
      "version": 1
    }
  ],
  "dependencies": [],
  "types": {
    "Approximation": {
      "kind": "symbol",
      "values": [
        "representative_grid_point",
        "selected_station_envelope"
      ]
    },
    "Biome": {
      "kind": "symbol",
      "values": [
        "boreal_forest_taiga",
        "deserts_and_xeric_shrublands",
        "flooded_grasslands_and_savannas",
        "mangroves",
        "mediterranean_forests_woodlands_and_scrub",
        "montane_grassland_and_shrubland",
        "temperate_broadleaf_and_mixed_forest",
        "temperate_conifer_forest",
        "temperate_grassland_savanna_and_shrubland",
        "tropical_and_subtropical_coniferous_forest",
        "tropical_and_subtropical_dry_broadleaf_forest",
        "tropical_and_subtropical_grassland_savanna_and_shrubland",
        "tropical_and_subtropical_moist_broadleaf_forest",
        "tundra"
      ]
    },
    "ClimateBand": {
      "kind": "symbol",
      "values": [
        "alpine",
        "arid",
        "humid_continental",
        "polar",
        "subtropical",
        "temperate_oceanic",
        "tropical_oceanic"
      ]
    },
    "ClimateOverride": {
      "kind": "object",
      "fields": {
        "annual_mean_temperature_c": {
          "type": {
            "kind": "named",
            "name": "NumericRange"
          },
          "required": false,
          "description": "Optional fictional annual mean temperature range in degrees Celsius."
        },
        "annual_precipitation_mm": {
          "type": {
            "kind": "named",
            "name": "NumericRange"
          },
          "required": false,
          "description": "Optional fictional annual precipitation range in millimetres per year."
        },
        "band": {
          "type": {
            "kind": "named",
            "name": "ClimateBand"
          },
          "required": false,
          "description": "Optional fictional broad climate band."
        }
      }
    },
    "ClimateSummary": {
      "kind": "object",
      "fields": {
        "annual_mean_temperature_c": {
          "type": {
            "kind": "named",
            "name": "NumericRange"
          },
          "required": true,
          "description": "Minimum and maximum annual mean air temperature across the reviewed observations, in degrees Celsius."
        },
        "annual_precipitation_mm": {
          "type": {
            "kind": "named",
            "name": "NumericRange"
          },
          "required": true,
          "description": "Minimum and maximum annual precipitation across the reviewed observations, in millimetres per year."
        },
        "band": {
          "type": {
            "kind": "named",
            "name": "ClimateBand"
          },
          "required": true,
          "description": "A broad narrative climate classification."
        },
        "confidence": {
          "type": {
            "kind": "named",
            "name": "Confidence"
          },
          "required": true,
          "description": "How precisely this summary represents the reference area."
        },
        "reference_period": {
          "type": {
            "kind": "string",
            "min_length": 9,
            "max_length": 9
          },
          "required": true,
          "description": "The climatological normal period in YYYY-YYYY form."
        },
        "source_resolution": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 256
          },
          "required": true,
          "description": "Published observation grid, station, or area resolution."
        },
        "spatial_resolution": {
          "type": {
            "kind": "named",
            "name": "SpatialResolution"
          },
          "required": true,
          "description": "The geographic resolution represented by the normalized values."
        },
        "uncertainty": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 512
          },
          "required": true,
          "description": "Concise limitations and uncertainty for this broad environmental approximation."
        },
        "units": {
          "type": {
            "kind": "named",
            "name": "ClimateUnits"
          },
          "required": true,
          "description": "Explicit canonical units for the normalized climate ranges."
        }
      }
    },
    "ClimateUnits": {
      "kind": "object",
      "fields": {
        "precipitation": {
          "type": {
            "kind": "named",
            "name": "PrecipitationUnit"
          },
          "required": true,
          "description": "Canonical annual precipitation unit."
        },
        "temperature": {
          "type": {
            "kind": "named",
            "name": "TemperatureUnit"
          },
          "required": true,
          "description": "Canonical air-temperature unit."
        }
      }
    },
    "Confidence": {
      "kind": "symbol",
      "values": [
        "high",
        "low",
        "moderate",
        "representative_not_exhaustive",
        "unknown"
      ]
    },
    "DaylightMethod": {
      "kind": "symbol",
      "values": [
        "astronomical_solstice_estimate"
      ]
    },
    "DaylightSummary": {
      "kind": "object",
      "fields": {
        "longest_daylight_hours": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": 0.0,
            "maximum": 24.0
          },
          "required": true,
          "description": "Idealized longer-solstice daylight rounded to one decimal hour."
        },
        "method": {
          "type": {
            "kind": "named",
            "name": "DaylightMethod"
          },
          "required": true,
          "description": "Closed deterministic daylight method."
        },
        "representative_latitude_degrees": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": -90.0,
            "maximum": 90.0
          },
          "required": true,
          "description": "WGS84 latitude used for the broad daylight approximation."
        },
        "shortest_daylight_hours": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": 0.0,
            "maximum": 24.0
          },
          "required": true,
          "description": "Idealized shorter-solstice daylight rounded to one decimal hour."
        },
        "unit": {
          "type": {
            "kind": "named",
            "name": "DaylightUnit"
          },
          "required": true,
          "description": "Canonical daylight duration unit."
        }
      }
    },
    "DaylightUnit": {
      "kind": "symbol",
      "values": [
        "hours_per_day"
      ]
    },
    "EnvironmentOverride": {
      "kind": "object",
      "fields": {
        "coastal": {
          "type": {
            "kind": "bool"
          },
          "required": false,
          "description": "Optional fictional coastal setting decision."
        },
        "island_system": {
          "type": {
            "kind": "bool"
          },
          "required": false,
          "description": "Optional fictional island-system setting decision."
        },
        "primary_biome": {
          "type": {
            "kind": "named",
            "name": "Biome"
          },
          "required": false,
          "description": "Optional fictional local biome override."
        },
        "terrain": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "Terrain"
            },
            "min_items": 0,
            "max_items": 8
          },
          "required": false,
          "description": "Optional fictional local terrain override."
        },
        "water_setting": {
          "type": {
            "kind": "named",
            "name": "WaterSetting"
          },
          "required": false,
          "description": "Optional fictional local water-setting override."
        },
        "weather_tendencies": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "WeatherTendency"
            },
            "min_items": 0,
            "max_items": 8
          },
          "required": false,
          "description": "Optional fictional local weather-tendency override."
        }
      }
    },
    "FactContext": {
      "kind": "object",
      "fields": {
        "approximation": {
          "type": {
            "kind": "named",
            "name": "Approximation"
          },
          "required": true,
          "description": "Deterministic policy used to represent a broader area."
        },
        "geographic_resolution": {
          "type": {
            "kind": "named",
            "name": "SpatialResolution"
          },
          "required": true,
          "description": "Geographic scope represented by the seed."
        },
        "uncertainty": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 512
          },
          "required": true,
          "description": "Concise limitations for interpreting this environmental seed."
        }
      }
    },
    "HazardMethod": {
      "kind": "symbol",
      "values": [
        "deterministic_environmental_thresholds_v1"
      ]
    },
    "HazardSummary": {
      "kind": "object",
      "fields": {
        "confidence": {
          "type": {
            "kind": "named",
            "name": "Confidence"
          },
          "required": true,
          "description": "Confidence inherited from the environmental approximation."
        },
        "method": {
          "type": {
            "kind": "named",
            "name": "HazardMethod"
          },
          "required": true,
          "description": "Closed deterministic environmental tendency policy."
        },
        "tendencies": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "HazardTendency"
            },
            "min_items": 0,
            "max_items": 8
          },
          "required": true,
          "description": "Broad environmental tendencies, never forecasts or risk scores."
        }
      }
    },
    "HazardTendency": {
      "kind": "symbol",
      "values": [
        "coastal_inundation",
        "heavy_precipitation",
        "seasonal_freeze",
        "slope_instability",
        "tropical_cyclone"
      ]
    },
    "Hemisphere": {
      "kind": "symbol",
      "values": [
        "equatorial",
        "northern",
        "southern"
      ]
    },
    "Month": {
      "kind": "symbol",
      "values": [
        "april",
        "august",
        "december",
        "february",
        "january",
        "july",
        "june",
        "march",
        "may",
        "november",
        "october",
        "september"
      ]
    },
    "NumericRange": {
      "kind": "object",
      "fields": {
        "maximum": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": -100.0,
            "maximum": 10000.0
          },
          "required": true,
          "description": "Inclusive upper endpoint."
        },
        "minimum": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": -100.0,
            "maximum": 10000.0
          },
          "required": true,
          "description": "Inclusive lower endpoint."
        }
      }
    },
    "PlaceKind": {
      "kind": "symbol",
      "values": [
        "region",
        "route",
        "settlement",
        "site",
        "territory",
        "world"
      ]
    },
    "PrecipitationUnit": {
      "kind": "symbol",
      "values": [
        "millimetres_per_year"
      ]
    },
    "ReferenceKind": {
      "kind": "symbol",
      "values": [
        "country",
        "ecosystem",
        "island_group",
        "region",
        "subregion"
      ]
    },
    "ReferencePreset": {
      "kind": "string",
      "min_length": 1,
      "max_length": 128
    },
    "Seasonality": {
      "kind": "object",
      "fields": {
        "coolest_month": {
          "type": {
            "kind": "named",
            "name": "Month"
          },
          "required": true,
          "description": "Coolest month in the normalized station average."
        },
        "hemisphere": {
          "type": {
            "kind": "named",
            "name": "Hemisphere"
          },
          "required": true,
          "description": "Hemisphere used to interpret the seasonal cycle."
        },
        "warmest_months": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "Month"
            },
            "min_items": 1,
            "max_items": 3
          },
          "required": true,
          "description": "Warmest months in the normalized station average."
        }
      }
    },
    "SpatialResolution": {
      "kind": "symbol",
      "values": [
        "country_scale_representative_point",
        "country_scale_selected_stations",
        "ecosystem_scale_representative_point",
        "region_scale_representative_point",
        "subregion_scale_representative_point"
      ]
    },
    "TemperatureUnit": {
      "kind": "symbol",
      "values": [
        "degrees_celsius"
      ]
    },
    "Terrain": {
      "kind": "symbol",
      "values": [
        "atoll",
        "coastal",
        "island",
        "mountain",
        "plain",
        "volcanic"
      ]
    },
    "TypedAttributes": {
      "kind": "object",
      "fields": {
        "booleans": {
          "type": {
            "kind": "map",
            "values": {
              "kind": "bool"
            },
            "min_entries": 0,
            "max_entries": 64
          },
          "required": false,
          "description": "Extensible boolean attributes keyed by stable authored names."
        },
        "numbers": {
          "type": {
            "kind": "map",
            "values": {
              "kind": "number",
              "integer": false,
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "min_entries": 0,
            "max_entries": 64
          },
          "required": false,
          "description": "Extensible finite numeric attributes keyed by stable authored names."
        },
        "strings": {
          "type": {
            "kind": "map",
            "values": {
              "kind": "string",
              "min_length": 0,
              "max_length": 512
            },
            "min_entries": 0,
            "max_entries": 64
          },
          "required": false,
          "description": "Extensible free-text attributes keyed by stable authored names."
        },
        "symbols": {
          "type": {
            "kind": "map",
            "values": {
              "kind": "string",
              "min_length": 1,
              "max_length": 64
            },
            "min_entries": 0,
            "max_entries": 64
          },
          "required": false,
          "description": "Extensible symbolic attributes stored as explicit stable tokens."
        }
      }
    },
    "WaterContext": {
      "kind": "object",
      "fields": {
        "coastal": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Whether coast is a defining country-scale feature."
        },
        "island_system": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Whether the reference is represented as an island system."
        },
        "setting": {
          "type": {
            "kind": "named",
            "name": "WaterSetting"
          },
          "required": true,
          "description": "Broad water setting for narrative conditions."
        }
      }
    },
    "WaterSetting": {
      "kind": "symbol",
      "values": [
        "freshwater_dominated",
        "oceanic_archipelago",
        "oceanic_atolls",
        "oceanic_islands",
        "open_ocean_coast",
        "river_delta",
        "semi_enclosed_sea_coast"
      ]
    },
    "WeatherTendency": {
      "kind": "symbol",
      "values": [
        "alpine_cooling",
        "coastal_moderation",
        "cyclone_exposure",
        "dry_season",
        "freeze_thaw",
        "monsoon_cycle",
        "regional_rainfall_contrast",
        "seasonal_temperature_cycle",
        "snow_season",
        "tropical_rainfall"
      ]
    },
    "WorldIdentity": {
      "kind": "object",
      "fields": {
        "culture_included": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Always false for the environmental-only reference preset."
        },
        "display_name": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Human-readable reference name."
        },
        "preset": {
          "type": {
            "kind": "named",
            "name": "ReferencePreset"
          },
          "required": true,
          "description": "Stable reference-place shorthand selected by the pack."
        },
        "reference_code": {
          "type": {
            "kind": "string",
            "min_length": 3,
            "max_length": 3
          },
          "required": true,
          "description": "Stable three-letter country reference code."
        },
        "reference_kind": {
          "type": {
            "kind": "named",
            "name": "ReferenceKind"
          },
          "required": true,
          "description": "Geographic scope represented by the seed."
        }
      }
    },
    "WorldPlace": {
      "kind": "object",
      "fields": {
        "attributes": {
          "type": {
            "kind": "named",
            "name": "TypedAttributes"
          },
          "required": false,
          "description": "Optional extensible attributes separated by portable value type."
        },
        "climate_override": {
          "type": {
            "kind": "named",
            "name": "ClimateOverride"
          },
          "required": false,
          "description": "Optional authored local climate decisions."
        },
        "climate_source": {
          "type": {
            "kind": "string",
            "min_length": 0,
            "max_length": 64
          },
          "required": true,
          "description": "Place id to inherit climate from; empty inherits the reference seed."
        },
        "environment_override": {
          "type": {
            "kind": "named",
            "name": "EnvironmentOverride"
          },
          "required": false,
          "description": "Optional authored local environment decisions."
        },
        "environment_source": {
          "type": {
            "kind": "string",
            "min_length": 0,
            "max_length": 64
          },
          "required": true,
          "description": "Place id to inherit environment from; empty inherits the reference seed."
        },
        "id": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 64
          },
          "required": true,
          "description": "Stable authored place identifier equal to its map key."
        },
        "kind": {
          "type": {
            "kind": "named",
            "name": "PlaceKind"
          },
          "required": true,
          "description": "Broad structural role of this fictional place."
        },
        "name": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Author-supplied fictional display name; changing it preserves the id."
        },
        "order": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 0.0,
            "maximum": 100000.0
          },
          "required": true,
          "description": "Deterministic sibling ordering independent of map serialization order."
        },
        "parent_id": {
          "type": {
            "kind": "string",
            "min_length": 0,
            "max_length": 64
          },
          "required": true,
          "description": "Parent place id; empty identifies a hierarchy root."
        },
        "related_place_ids": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 64
            },
            "min_items": 0,
            "max_items": 32
          },
          "required": true,
          "description": "Unique symmetric references to related stable place ids."
        }
      }
    },
    "WorldSeed": {
      "kind": "object",
      "fields": {
        "attribution": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 512
          },
          "required": true,
          "description": "Compact attribution retained in portable runtime exports."
        },
        "biomes": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "Biome"
            },
            "min_items": 1,
            "max_items": 8
          },
          "required": true,
          "description": "Representative terrestrial biome classes intersecting the reference area."
        },
        "climate": {
          "type": {
            "kind": "named",
            "name": "ClimateSummary"
          },
          "required": true,
          "description": "Normalized representative climate facts."
        },
        "context": {
          "type": {
            "kind": "named",
            "name": "FactContext"
          },
          "required": true,
          "description": "Explicit geographic scale, approximation, and uncertainty."
        },
        "daylight": {
          "type": {
            "kind": "named",
            "name": "DaylightSummary"
          },
          "required": true,
          "description": "Idealized latitude-derived solstice daylight range."
        },
        "hazards": {
          "type": {
            "kind": "named",
            "name": "HazardSummary"
          },
          "required": true,
          "description": "Deterministically derived environmental hazard tendencies."
        },
        "identity": {
          "type": {
            "kind": "named",
            "name": "WorldIdentity"
          },
          "required": true,
          "description": "Stable environmental reference identity."
        },
        "primary_biome": {
          "type": {
            "kind": "named",
            "name": "Biome"
          },
          "required": true,
          "description": "One broad biome suitable for concise narrative conditions."
        },
        "seasonality": {
          "type": {
            "kind": "named",
            "name": "Seasonality"
          },
          "required": true,
          "description": "Representative annual temperature cycle."
        },
        "terrain": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "Terrain"
            },
            "min_items": 1,
            "max_items": 8
          },
          "required": true,
          "description": "Country-scale terrain tendencies."
        },
        "water": {
          "type": {
            "kind": "named",
            "name": "WaterContext"
          },
          "required": true,
          "description": "Country-scale coastal and island context."
        },
        "weather_tendencies": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "WeatherTendency"
            },
            "min_items": 1,
            "max_items": 8
          },
          "required": true,
          "description": "Evidence-backed tendencies for narrative variation, not a forecast."
        }
      }
    }
  },
  "exports": {
    "places": {
      "type": {
        "kind": "map",
        "values": {
          "kind": "named",
          "name": "WorldPlace"
        },
        "min_entries": 0,
        "max_entries": 1024
      },
      "required": false,
      "source": "pack",
      "description": "Stable fictional places authored over the selected environmental reference seed."
    },
    "rules": {
      "type": {
        "kind": "named",
        "name": "TypedAttributes"
      },
      "required": false,
      "source": "pack",
      "description": "Typed, namespaced fictional world rules available to narrative and host consumers."
    },
    "seed": {
      "type": {
        "kind": "named",
        "name": "WorldSeed"
      },
      "required": true,
      "source": "pack",
      "description": "The deterministic environmental world seed selected by the active reference-place pack."
    }
  },
  "authoring": {
    "entity_collections": [
      {
        "export": "places",
        "id_field": "id",
        "label_field": "name",
        "order_field": "order",
