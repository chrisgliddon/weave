      ],
      "values.seed.identity": [
        "normalize_identity"
      ],
      "values.seed.primary_biome": [
        "normalize_biomes"
      ],
      "values.seed.seasonality": [
        "normalize_climate"
      ],
      "values.seed.terrain": [
        "normalize_terrain_water"
      ],
      "values.seed.water": [
        "normalize_terrain_water"
      ],
      "values.seed.weather_tendencies": [
        "normalize_climate"
      ]
    }
