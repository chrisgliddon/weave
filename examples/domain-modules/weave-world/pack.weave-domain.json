    "transformations": [
      {
        "id": "normalize_biomes",
        "inputs": [
          "resolve_ecoregions"
        ],
        "description": "Deduplicate the biome classes intersecting the country envelope, normalize their names to stable lowercase symbols, and select the dominant forest class as the narrative primary biome."
      },
      {
        "id": "normalize_climate",
        "inputs": [
          "niwa_rainfall",
          "niwa_temperature"
        ],
        "description": "Read the published annual and monthly station means, exclude the explicitly out-of-scope Scott Base temperature row, retain Celsius and millimetre units, take the in-scope annual minima and maxima, and rank monthly cross-station temperature means deterministically."
      },
      {
        "id": "normalize_identity",
        "inputs": [
          "natural_earth_land",
          "weave_world_fixture"
        ],
        "description": "Bind the original stable preset selector and display identity to the country-scale land reference without adding cultural or linguistic assertions."
      },
      {
        "id": "normalize_terrain_water",
        "inputs": [
          "natural_earth_land",
          "natural_earth_ocean",
          "resolve_ecoregions"
        ],
        "description": "Reduce the public country-scale physical and biome geometry to conservative coastal, island, mountain, and oceanic-island categories suitable for narrative conditions."
      },
      {
        "id": "normalize_world_seed",
        "inputs": [
          "normalize_biomes",
          "normalize_climate",
          "normalize_identity",
          "normalize_terrain_water"
        ],
        "description": "Assemble the normalized environmental facts into one deterministic typed WorldSeed; no cultural traits, names, or population claims are inferred."
      }
    ],
    "claims": {
      "values.seed": [
        "normalize_world_seed"
      ],
      "values.seed.attribution": [
        "normalize_world_seed"
      ],
      "values.seed.biomes": [
        "normalize_biomes"
      ],
      "values.seed.climate": [
