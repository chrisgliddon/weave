module character {
    id: "org.weave.character"
    version: "=1.6.0"
    pack: "ari_vale@=1.0.0"
    override profile.identity.display_name.value: "Ari Vale, Wayfinder"
}

VAR character_name = character.profile.identity.display_name.value
VAR openness = character.profile.hexaco.openness.summary.projection_score
VAR creativity = character.profile.hexaco.openness.creativity.projection_score
VAR ocean_openness = character.profile.ocean.openness.score
VAR alignment_pack = character.profile.alignment.pack.id
VAR alignment_pack_version = character.profile.alignment.pack.version
VAR alignment_pack_sha256 = character.profile.alignment.pack.sha256
VAR alignment_horizon = character.profile.alignment.values.horizon.label
VAR alignment_reciprocity = character.profile.alignment.values.reciprocity.label
VAR alignment_personality_writeback = character.profile.alignment.canonical_personality_write_back
VAR presentation_subject = character.profile.presentation.pronouns.subject
VAR presentation_accent = character.profile.presentation.palette.colors.accent
VAR presentation_avatar = character.profile.presentation.assets.authored_avatar.path
VAR presentation_catalog = character.profile.presentation.catalog_assignments.avatar.catalog.id
VAR presentation_catalog_sha256 = character.profile.presentation.catalog_assignments.avatar.catalog.sha256
VAR presentation_personality_writeback = character.profile.presentation.canonical_personality_write_back
VAR mentor_target = character.profile.relationships.edges.mentor_sable.target_character_id
VAR mentor_kind = character.profile.relationships.edges.mentor_sable.kind
VAR relationship_pack = character.profile.relationships.kind_pack.id
VAR relationship_pack_version = character.profile.relationships.kind_pack.version
VAR relationship_pack_sha256 = character.profile.relationships.kind_pack.sha256
VAR relationship_personality_writeback = character.profile.relationships.canonical_personality_write_back
VAR expression_term = character.profile.expression.lexicon.trailmark.surface
VAR expression_preference = character.profile.expression.preferences.clear_questions.target
VAR expression_template = character.profile.expression.template_assignments.arrival_greeting.template_id
VAR expression_pack = character.profile.expression.template_assignments.arrival_greeting.pack.id
VAR expression_pack_sha256 = character.profile.expression.template_assignments.arrival_greeting.pack.sha256
VAR expression_personality_writeback = character.profile.expression.canonical_personality_write_back
VAR projection_personality = character.profile.projections.values.personality_lens.label
VAR projection_personality_lossy = character.profile.projections.values.personality_lens.lossy
VAR projection_vocation = character.profile.projections.values.vocation.label
VAR projection_social_role = character.profile.projections.values.social_role.label
VAR projection_narrative_role = character.profile.projections.values.narrative_role.label
VAR projection_explanation = character.profile.projections.values.narrative_role.explanation
VAR projection_rationale = character.profile.projections.values.narrative_role.rationale
VAR projection_lock = character.profile.projections.values.narrative_role.lock
VAR projection_pack = character.profile.projections.values.narrative_role.pack.id
VAR projection_pack_version = character.profile.projections.values.narrative_role.pack.version
VAR projection_pack_sha256 = character.profile.projections.values.narrative_role.pack.sha256
VAR projection_proposal_sha256 = character.profile.projections.values.narrative_role.proposal_sha256
VAR projection_review_sha256 = character.profile.projections.values.narrative_role.review_sha256
VAR projection_hexaco_writeback = character.profile.projections.write_back.hexaco

=== start ===
{presentation_personality_writeback:
    This branch is unreachable because presentation cannot become personality evidence.
- else:
    Presentation remains separate from personality evidence.
}
{alignment_personality_writeback:
    This branch is unreachable because reviewed alignment shorthand cannot become personality evidence.
- else:
    {character.profile.ocean.lossy:
        {character_name} uses {presentation_subject} pronouns, accent {presentation_accent}, avatar {presentation_avatar}, and reviewed presentation catalog {presentation_catalog} ({presentation_catalog_sha256}); the same profile carries {creativity} creativity evidence, a derived OCEAN openness view of {ocean_openness}, and reviewed {alignment_horizon} / {alignment_reciprocity} narrative alignment labels selected from {alignment_pack}@{alignment_pack_version} ({alignment_pack_sha256}).
    - else:
        The compatibility projection is unavailable.
    }
}
{relationship_personality_writeback:
    This branch is unreachable because relationships cannot become personality evidence.
- else:
    Runtime relationship query: {mentor_kind} toward {mentor_target} from {relationship_pack}@{relationship_pack_version} ({relationship_pack_sha256}).
}
{expression_personality_writeback:
    This branch is unreachable because expression cannot become personality evidence.
- else:
    Runtime expression query: {expression_term}; preference {expression_preference}; template {expression_template} from {expression_pack} ({expression_pack_sha256}).
}
{projection_hexaco_writeback:
    This branch is unreachable because projection labels cannot become HEXACO evidence.
- else:
    Reviewed projection query: lossy={projection_personality_lossy} {projection_personality}; vocation {projection_vocation}; social role {projection_social_role}; narrative role {projection_narrative_role} ({projection_lock}) from {projection_pack}@{projection_pack_version} ({projection_pack_sha256}), proposal {projection_proposal_sha256}, review {projection_review_sha256}. Explanation: {projection_explanation} Rationale: {projection_rationale}
}
-> END
