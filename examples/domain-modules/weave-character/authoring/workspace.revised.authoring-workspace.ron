                        pack: (
                            pack_format_version: 1,
                            id: "org.weave.character.questionnaire.lantern_choices",
                            version: "1.0.0",
                            title: "Lantern Choices",
                            methodology: "Each independently written fictional behavior response contributes through one declared signed fixed-point facet weight; authors review every result before canon changes.",
                            limitations: [
                                "It is a fictional authoring aid, not an assessment of a person.",
                                "Scores are reviewable prompts and are not independent personality evidence.",
                            ],
                            narrative_authoring_only: true,
                            independently_authored_prompts: true,
                            license: "MIT",
                            license_url: "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
                            items: {
                                "behavior_00": (
                                    id: "behavior_00",
                                    prompt: "When a promise becomes inconvenient, the character states their real intent plainly.",
                                    facet_weights_micros: {
                                        sincerity: 1000000,
                                    },
                                ),
                                "behavior_01": (
                                    id: "behavior_01",
                                    prompt: "When dividing scarce supplies, the character applies the same rule to every companion.",
                                    facet_weights_micros: {
                                        fairness: 1000000,
                                    },
                                ),
                                "behavior_02": (
                                    id: "behavior_02",
                                    prompt: "When offered status for its own sake, the character can leave the offer behind.",
                                    facet_weights_micros: {
                                        greed_avoidance: 1000000,
                                    },
                                ),
                                "behavior_03": (
                                    id: "behavior_03",
                                    prompt: "When praised in a crowded room, the character shares credit without erasing their work.",
                                    facet_weights_micros: {
                                        modesty: 1000000,
                                    },
                                ),
                                "behavior_04": (
                                    id: "behavior_04",
                                    prompt: "When a route becomes dangerous, the character notices the risk before stepping forward.",
                                    facet_weights_micros: {
                                        fearfulness: 1000000,
                                    },
                                ),
                                "behavior_05": (
                                    id: "behavior_05",
                                    prompt: "When plans remain uncertain, the character revisits possible outcomes before resting.",
                                    facet_weights_micros: {
                                        anxiety: 1000000,
                                    },
                                ),
                                "behavior_06": (
                                    id: "behavior_06",
                                    prompt: "When overwhelmed, the character asks a trusted companion to stay nearby.",
                                    facet_weights_micros: {
                                        dependence: 1000000,
                                    },
                                ),
                                "behavior_07": (
                                    id: "behavior_07",
                                    prompt: "When an old keepsake resurfaces, the character allows the memory to affect the moment.",
                                    facet_weights_micros: {
                                        sentimentality: 1000000,
                                    },
                                ),
                                "behavior_08": (
                                    id: "behavior_08",
                                    prompt: "When challenged publicly, the character retains a stable sense of their own worth.",
                                    facet_weights_micros: {
                                        social_self_esteem: 1000000,
                                    },
                                ),
                                "behavior_09": (
                                    id: "behavior_09",
                                    prompt: "When a room falls silent, the character is willing to speak first.",
                                    facet_weights_micros: {
                                        social_boldness: 1000000,
                                    },
                                ),
                                "behavior_10": (
                                    id: "behavior_10",
                                    prompt: "When work pauses, the character seeks company rather than solitude.",
                                    facet_weights_micros: {
                                        sociability: 1000000,
                                    },
                                ),
                                "behavior_11": (
