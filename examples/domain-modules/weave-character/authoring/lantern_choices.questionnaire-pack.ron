(
    pack_format_version: 1,
    id: "org.weave.character.questionnaire.lantern_choices",
    version: "1.0.0",
    title: "Lantern Choices",
    methodology: "Each independently written fictional behavior response contributes through one declared signed fixed-point facet weight; authors review every result before canon changes.",
    limitations: [
        "It is a fictional authoring aid, not an assessment of a person.",
        "Scores are reviewable prompts and are not independent personality evidence.",
    ],
    narrative_authoring_only: true,
    independently_authored_prompts: true,
    license: "MIT",
    license_url: "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
    items: {
        "behavior_00": (
            id: "behavior_00",
            prompt: "When a promise becomes inconvenient, the character states their real intent plainly.",
            facet_weights_micros: {
                sincerity: 1000000,
            },
        ),
        "behavior_01": (
            id: "behavior_01",
            prompt: "When dividing scarce supplies, the character applies the same rule to every companion.",
            facet_weights_micros: {
                fairness: 1000000,
            },
        ),
        "behavior_02": (
            id: "behavior_02",
            prompt: "When offered status for its own sake, the character can leave the offer behind.",
            facet_weights_micros: {
                greed_avoidance: 1000000,
            },
        ),
        "behavior_03": (
            id: "behavior_03",
            prompt: "When praised in a crowded room, the character shares credit without erasing their work.",
            facet_weights_micros: {
                modesty: 1000000,
            },
        ),
        "behavior_04": (
            id: "behavior_04",
            prompt: "When a route becomes dangerous, the character notices the risk before stepping forward.",
            facet_weights_micros: {
                fearfulness: 1000000,
            },
        ),
        "behavior_05": (
            id: "behavior_05",
            prompt: "When plans remain uncertain, the character revisits possible outcomes before resting.",
            facet_weights_micros: {
                anxiety: 1000000,
            },
        ),
        "behavior_06": (
            id: "behavior_06",
            prompt: "When overwhelmed, the character asks a trusted companion to stay nearby.",
            facet_weights_micros: {
                dependence: 1000000,
            },
        ),
        "behavior_07": (
            id: "behavior_07",
            prompt: "When an old keepsake resurfaces, the character allows the memory to affect the moment.",
            facet_weights_micros: {
                sentimentality: 1000000,
            },
        ),
        "behavior_08": (
            id: "behavior_08",
            prompt: "When challenged publicly, the character retains a stable sense of their own worth.",
            facet_weights_micros: {
                social_self_esteem: 1000000,
            },
        ),
        "behavior_09": (
            id: "behavior_09",
            prompt: "When a room falls silent, the character is willing to speak first.",
            facet_weights_micros: {
                social_boldness: 1000000,
            },
        ),
        "behavior_10": (
            id: "behavior_10",
            prompt: "When work pauses, the character seeks company rather than solitude.",
            facet_weights_micros: {
                sociability: 1000000,
            },
        ),
        "behavior_11": (
            id: "behavior_11",
            prompt: "When the group is tired, the character brings visible energy back to the task.",
            facet_weights_micros: {
                liveliness: 1000000,
            },
        ),
        "behavior_12": (
            id: "behavior_12",
            prompt: "When someone repairs a past harm, the character can loosen an old grievance.",
            facet_weights_micros: {
                forgivingness: 1000000,
            },
        ),
        "behavior_13": (
            id: "behavior_13",
            prompt: "When correcting a mistake, the character chooses language that preserves dignity.",
            facet_weights_micros: {
                gentleness: 1000000,
            },
        ),
        "behavior_14": (
            id: "behavior_14",
            prompt: "When a plan changes, the character can adapt without treating revision as defeat.",
            facet_weights_micros: {
                flexibility: 1000000,
            },
        ),
        "behavior_15": (
            id: "behavior_15",
            prompt: "When provoked, the character leaves space before answering.",
            facet_weights_micros: {
                patience: 1000000,
            },
        ),
        "behavior_16": (
            id: "behavior_16",
            prompt: "When tools scatter, the character restores an order others can follow.",
            facet_weights_micros: {
                organization: 1000000,
            },
        ),
        "behavior_17": (
            id: "behavior_17",
            prompt: "When a long task becomes repetitive, the character continues the necessary work.",
            facet_weights_micros: {
                diligence: 1000000,
            },
        ),
        "behavior_18": (
            id: "behavior_18",
            prompt: "When a craft is nearly complete, the character still notices small inconsistencies.",
            facet_weights_micros: {
                perfectionism: 1000000,
            },
        ),
        "behavior_19": (
            id: "behavior_19",
            prompt: "Before a consequential choice, the character checks likely effects and escape routes.",
            facet_weights_micros: {
                prudence: 1000000,
            },
        ),
        "behavior_20": (
            id: "behavior_20",
            prompt: "When entering an unfamiliar place, the character pauses to notice its form and texture.",
            facet_weights_micros: {
                aesthetic_appreciation: 1000000,
            },
        ),
        "behavior_21": (
            id: "behavior_21",
            prompt: "When a mechanism behaves strangely, the character keeps asking how it works.",
            facet_weights_micros: {
                inquisitiveness: 1000000,
            },
        ),
        "behavior_22": (
            id: "behavior_22",
            prompt: "When a familiar method fails, the character invents another way to frame the problem.",
            facet_weights_micros: {
                creativity: 1000000,
            },
        ),
        "behavior_23": (
            id: "behavior_23",
            prompt: "When custom blocks a useful idea, the character is willing to question the custom.",
            facet_weights_micros: {
                unconventionality: 1000000,
            },
        ),
    },
    conflict_rules: {
        "bold_plan_tension": (
            id: "bold_plan_tension",
            label: "Bold plan tension",
            explanation: "High social boldness and high prudence can be retained as an intentional fictional tension rather than silently averaged.",
            predicates: [
                (
                    trait_id: social_boldness,
                    comparison: at_least,
                    threshold_micros: 700000,
                ),
                (
                    trait_id: prudence,
                    comparison: at_least,
                    threshold_micros: 700000,
                ),
            ],
            rejected_traits: [
                social_boldness,
                prudence,
            ],
            rationale_required: true,
        ),
    },
    provenance: (
        sources: [
            (
                id: "questionnaire_original",
                kind: original,
                url: "https://github.com/chrisgliddon/weave",
                revision: "guided-authoring-v1",
                license: "MIT",
                license_url: "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
                attribution: "Original synthetic Lantern Choices questionnaire pack.",
                modified: false,
            ),
        ],
        transformations: [],
        claims: {
            "pack": [
                "questionnaire_original",
            ],
        },
    ),
)
