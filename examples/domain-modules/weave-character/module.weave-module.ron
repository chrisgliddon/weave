(
    contract_version: 1,
    pack_format_version: 1,
    id: "org.weave.character",
    version: "1.4.0",
    namespace: "character",
    title: "Weave Character",
    summary: "Typed, provenance-aware Character Profiles with canonical HEXACO evidence, layered relationship graphs, non-canonical identity presentation, and a visibly lossy derived OCEAN view.",
    authors: [
        (
            name: "Weave Contributors",
            url: Some("https://github.com/chrisgliddon/weave"),
        ),
    ],
    license: "MIT",
    license_url: "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
    weave_version: ">=0.1.0, <0.2.0",
    capabilities: [
        (
            id: "data",
            version: 1,
        ),
        (
            id: "editor_schema",
            version: 1,
        ),
    ],
    dependencies: [],
    types: {
        "Agreeableness": (
            kind: "object",
            fields: {
                "flexibility": (
                    type: (
                        kind: "named",
                        name: "TraitEvidence",
                    ),
                    required: false,
                    description: "Optional canonical HEXACO facet evidence; absence is never imputed.",
                ),
                "forgivingness": (
                    type: (
                        kind: "named",
                        name: "TraitEvidence",
                    ),
                    required: false,
                    description: "Optional canonical HEXACO facet evidence; absence is never imputed.",
                ),
                "gentleness": (
                    type: (
                        kind: "named",
                        name: "TraitEvidence",
                    ),
                    required: false,
                    description: "Optional canonical HEXACO facet evidence; absence is never imputed.",
                ),
                "patience": (
                    type: (
                        kind: "named",
                        name: "TraitEvidence",
                    ),
                    required: false,
                    description: "Optional canonical HEXACO facet evidence; absence is never imputed.",
                ),
                "summary": (
                    type: (
                        kind: "named",
                        name: "TraitEvidence",
                    ),
                    required: false,
                    description: "Optional canonical factor summary; absence is explicit missing data.",
                ),
            },
        ),
        "AttributedText": (
            kind: "object",
            fields: {
                "confidence": (
                    type: (
                        kind: "symbol",
                        values: [
                            "high",
                            "low",
                            "moderate",
                            "unknown",
                        ],
                    ),
                    required: true,
                    description: "Confidence in this representation.",
                ),
                "freshness": (
                    type: (
                        kind: "symbol",
                        values: [
                            "current",
                            "stale",
                        ],
                    ),
                    required: true,
                    description: "Whether exact upstream inputs remain current.",
                ),
                "lineage": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 1,
                        max_items: 256,
                    ),
                    required: true,
                    description: "Sorted profile provenance identifiers.",
                ),
                "lock": (
                    type: (
                        kind: "symbol",
                        values: [
                            "locked",
                            "unlocked",
                        ],
                    ),
                    required: true,
                    description: "Author lock state.",
                ),
                "rationale": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: false,
                    description: "Explanation retained for non-trivial value states.",
                ),
                "review": (
                    type: (
                        kind: "symbol",
                        values: [
                            "accepted",
                            "not_required",
                            "pending",
                            "rejected",
                        ],
                    ),
                    required: true,
                    description: "Editorial review state.",
                ),
                "state": (
                    type: (
                        kind: "symbol",
                        values: [
                            "authored",
                            "derived",
                            "imported",
                            "overridden",
                            "reviewed",
                            "suggested",
                        ],
                    ),
                    required: true,
                    description: "How the value entered the record.",
                ),
                "value": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Authored or reviewed text value.",
                ),
            },
        ),
        "CharacterAlignmentPack": (
            kind: "object",
            fields: {
                "id": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Exact alignment pack identity.",
                ),
                "sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact lowercase pack content SHA-256.",
                ),
                "version": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Exact alignment pack version.",
                ),
            },
        ),
        "CharacterAlignmentValue": (
            kind: "object",
            fields: {
                "coverage_micros": (
                    type: (
                        kind: "number",
                        integer: true,
                        minimum: Some(0.0),
                        maximum: Some(1000000.0),
                    ),
                    required: true,
                    description: "Exact evidence coverage in integer millionths.",
                ),
                "decision": (
                    type: (
                        kind: "symbol",
                        values: [
                            "edited",
                            "overridden",
                            "reviewed",
                        ],
                    ),
                    required: true,
                    description: "Review path by which this value entered the public view.",
                ),
                "explanation": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: true,
                    description: "Public non-diagnostic narrative explanation.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable alignment axis identifier.",
                ),
                "input_paths": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 512,
                        ),
                        min_items: 0,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Sorted canonical evidence paths actually used by the reviewed value.",
                ),
                "label": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Pack-declared public narrative label.",
                ),
                "label_id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable pack-declared label identifier.",
                ),
                "score_micros": (
                    type: (
                        kind: "number",
                        integer: true,
                        minimum: Some(-1000000.0),
                        maximum: Some(1000000.0),
                    ),
                    required: false,
                    description: "Optional exact signed score retained for the approved shorthand.",
                ),
            },
        ),
        "CharacterAlignmentView": (
            kind: "object",
            fields: {
                "applied_sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact atomic application fingerprint.",
                ),
                "canonical_personality_write_back": (
                    type: (
                        kind: "bool",
                    ),
                    required: true,
                    description: "Always false; alignment is never canonical evidence.",
                ),
                "input_paths": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 512,
                        ),
                        min_items: 0,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Sorted union of canonical paths used by approved public values.",
                ),
                "pack": (
                    type: (
                        kind: "named",
                        name: "CharacterAlignmentPack",
                    ),
                    required: true,
                    description: "Exact declarative alignment pack coordinate.",
                ),
                "review_sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact complete review fingerprint.",
                ),
                "values": (
                    type: (
                        kind: "map",
                        values: (
                            kind: "named",
                            name: "CharacterAlignmentValue",
                        ),
                        min_entries: 0,
                        max_entries: 4096,
                    ),
                    required: true,
                    description: "Approved alignment values only; rejected and withheld values stay private to the authoring receipt.",
                ),
                "view_id": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Selected alignment view identity.",
                ),
            },
        ),
        "CharacterAppearanceDescriptor": (
            kind: "object",
            fields: {
                "category": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Namespaced appearance category.",
                ),
                "content": (
                    type: (
                        kind: "named",
                        name: "AttributedText",
                    ),
                    required: true,
                    description: "Authored appearance description.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable local appearance-record identifier.",
                ),
            },
        ),
        "CharacterDateContext": (
            kind: "object",
            fields: {
                "accepted_record_ids": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 128,
                        ),
                        min_items: 0,
                        max_items: 65536,
                    ),
                    required: true,
                    description: "Sorted temporal records with accepted cues; empty means no reviewed cue was accepted.",
                ),
                "canonical_personality_write_back": (
                    type: (
                        kind: "bool",
                    ),
                    required: true,
                    description: "Always false; temporal context is never personality evidence.",
                ),
                "cues": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "named",
                            name: "CharacterDateCue",
                        ),
                        min_items: 0,
                        max_items: 16384,
                    ),
                    required: true,
                    description: "Reviewed fictional cues in stable candidate-id order.",
                ),
                "packs": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "named",
                            name: "CharacterDatePack",
                        ),
                        min_items: 1,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Exact context pack coordinates retained by the review.",
                ),
            },
        ),
        "CharacterDateCue": (
            kind: "object",
            fields: {
                "content": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: true,
                    description: "Reviewed fictional authoring cue.",
                ),
                "cue_source_ids": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 1,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Lineage for the fictional cue and declared ranking vector.",
                ),
                "decision": (
                    type: (
                        kind: "symbol",
                        values: [
                            "accepted",
                            "auto_approved",
                            "edited",
                            "overridden",
                        ],
                    ),
                    required: true,
                    description: "Exact review path by which the cue entered the public view.",
                ),
                "fact_source_ids": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 1,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Separate lineage for the matched dated fact.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable accepted cue identity.",
                ),
                "kind": (
                    type: (
                        kind: "symbol",
                        values: [
                            "affinity",
                            "memory",
                            "tension",
                            "value",
                            "voice",
                        ],
                    ),
                    required: true,
                    description: "Fictional authoring surface affected by this pending cue.",
                ),
                "pack_id": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Owning exact context pack identity.",
                ),
                "record_id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Matched temporal record identity.",
                ),
                "relevance": (
                    type: (
                        kind: "number",
                        integer: false,
                        minimum: Some(0.0),
                        maximum: Some(1.0),
                    ),
                    required: true,
                    description: "Deterministic fixed-point relevance exposed as a normalized number.",
                ),
                "review_sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact complete review fingerprint.",
                ),
                "sensitivity": (
                    type: (
                        kind: "symbol",
                        values: [
                            "high",
                            "low",
                            "moderate",
                        ],
                    ),
                    required: true,
                    description: "Review sensitivity retained from the source record.",
                ),
                "uncertainty": (
                    type: (
                        kind: "symbol",
                        values: [
                            "bounded",
                            "disputed",
                            "exact",
                        ],
                    ),
                    required: true,
                    description: "Bounded fact uncertainty retained independently from relevance.",
                ),
            },
        ),
        "CharacterDatePack": (
            kind: "object",
            fields: {
                "id": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Exact temporal context pack identity.",
                ),
                "sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact lowercase pack content SHA-256.",
                ),
                "version": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Exact temporal context pack version.",
                ),
            },
        ),
        "CharacterIdentity": (
            kind: "object",
            fields: {
                "aliases": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 0,
                        max_items: 256,
                    ),
                    required: true,
                    description: "Ordered aliases, empty when no aliases are asserted.",
                ),
                "display_name": (
                    type: (
                        kind: "named",
                        name: "AttributedText",
                    ),
                    required: true,
                    description: "Primary display name with authority and lineage.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 256,
                    ),
                    required: true,
                    description: "Stable namespaced character identifier.",
                ),
            },
        ),
        "CharacterIdentityPresentation": (
            kind: "object",
            fields: {
                "appearance": (
                    type: (
                        kind: "map",
                        values: (
                            kind: "named",
                            name: "CharacterAppearanceDescriptor",
                        ),
                        min_entries: 0,
                        max_entries: 4096,
                    ),
                    required: true,
                    description: "Authored appearance descriptors keyed by stable local id.",
                ),
                "assets": (
                    type: (
                        kind: "map",
                        values: (
                            kind: "named",
                            name: "CharacterPresentationAsset",
                        ),
                        min_entries: 0,
                        max_entries: 4096,
                    ),
                    required: true,
                    description: "Portable attributed asset references.",
                ),
                "canonical_personality_write_back": (
                    type: (
                        kind: "bool",
                    ),
                    required: true,
                    description: "Always false; presentation cannot modify canonical personality evidence.",
                ),
                "catalog_assignments": (
                    type: (
                        kind: "map",
                        values: (
                            kind: "named",
                            name: "CharacterPresentationAssignment",
                        ),
                        min_entries: 0,
                        max_entries: 4096,
                    ),
                    required: true,
                    description: "Reviewed deterministic catalog assignments.",
                ),
                "context_notes": (
                    type: (
                        kind: "map",
                        values: (
                            kind: "named",
                            name: "CharacterPresentationText",
                        ),
                        min_entries: 0,
                        max_entries: 4096,
                    ),
                    required: true,
                    description: "Authored origin and context notes.",
                ),
                "identity_refs": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 3,
                            max_length: 256,
                        ),
                        min_items: 0,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Sorted optional identity references.",
                ),
                "palette": (
                    type: (
                        kind: "named",
                        name: "CharacterPresentationPalette",
                    ),
                    required: false,
                    description: "Optional attributed color palette.",
                ),
                "presentation_refs": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 2048,
                        ),
                        min_items: 0,
                        max_items: 4096,
                    ),
                    required: true,
                    description: "Sorted project-relative presentation references.",
                ),
                "pronouns": (
                    type: (
                        kind: "named",
                        name: "CharacterPresentationPronouns",
                    ),
                    required: false,
                    description: "Optional authored pronoun forms.",
                ),
                "style_tags": (
                    type: (
                        kind: "named",
                        name: "CharacterPresentationStyleTags",
                    ),
                    required: false,
                    description: "Optional attributed presentation style tags.",
                ),
            },
        ),
        "CharacterPresentationAsset": (
            kind: "object",
            fields: {
                "alt_text": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 512,
                    ),
                    required: true,
                    description: "Portable asset alternative text.",
                ),
                "confidence": (
                    type: (
                        kind: "symbol",
                        values: [
                            "high",
                            "low",
                            "moderate",
                            "unknown",
                        ],
                    ),
                    required: true,
                    description: "Confidence in this representation.",
                ),
                "freshness": (
                    type: (
                        kind: "symbol",
                        values: [
                            "current",
                            "stale",
                        ],
                    ),
                    required: true,
                    description: "Whether exact upstream inputs remain current.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable local asset identifier.",
                ),
                "kind": (
                    type: (
                        kind: "symbol",
                        values: [
                            "avatar",
                            "illustration",
                            "model",
                            "portrait",
                            "sprite",
                        ],
                    ),
                    required: true,
                    description: "Portable asset role.",
                ),
                "lineage": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 1,
                        max_items: 256,
                    ),
                    required: true,
                    description: "Sorted profile provenance identifiers.",
                ),
                "lock": (
                    type: (
                        kind: "symbol",
                        values: [
                            "locked",
                            "unlocked",
                        ],
                    ),
                    required: true,
                    description: "Author lock state.",
                ),
                "media_type": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Portable media type.",
                ),
                "path": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: true,
                    description: "Safe project-relative asset path.",
                ),
                "rationale": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: false,
                    description: "Explanation retained for non-trivial value states.",
                ),
                "review": (
                    type: (
                        kind: "symbol",
                        values: [
                            "accepted",
                            "not_required",
                            "pending",
                            "rejected",
                        ],
                    ),
                    required: true,
                    description: "Editorial review state.",
                ),
                "sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: false,
                    description: "Optional exact asset content SHA-256.",
                ),
                "state": (
                    type: (
                        kind: "symbol",
                        values: [
                            "authored",
                            "derived",
                            "imported",
                            "overridden",
                            "reviewed",
                            "suggested",
                        ],
                    ),
                    required: true,
                    description: "How the value entered the record.",
                ),
            },
        ),
        "CharacterPresentationAssetValue": (
            kind: "object",
            fields: {
                "alt_text": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 512,
                    ),
                    required: true,
                    description: "Portable asset alternative text.",
                ),
                "id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Stable local asset identifier.",
                ),
                "kind": (
                    type: (
                        kind: "symbol",
                        values: [
                            "avatar",
                            "illustration",
                            "model",
                            "portrait",
                            "sprite",
                        ],
                    ),
                    required: true,
                    description: "Portable asset role.",
                ),
                "media_type": (
                    type: (
                        kind: "string",
                        min_length: 3,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Portable media type.",
                ),
                "path": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: true,
                    description: "Safe project-relative asset path.",
                ),
                "sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: false,
                    description: "Optional exact asset content SHA-256.",
                ),
            },
        ),
        "CharacterPresentationAssignment": (
            kind: "object",
            fields: {
                "catalog": (
                    type: (
                        kind: "named",
                        name: "CharacterPresentationCatalog",
                    ),
                    required: true,
                    description: "Exact immutable catalog coordinate.",
                ),
                "confidence": (
                    type: (
                        kind: "symbol",
                        values: [
                            "high",
                            "low",
                            "moderate",
                            "unknown",
                        ],
                    ),
                    required: true,
                    description: "Confidence in this representation.",
                ),
                "entry_id": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 128,
                    ),
                    required: true,
                    description: "Reviewed catalog entry or author_override.",
                ),
                "freshness": (
                    type: (
                        kind: "symbol",
                        values: [
                            "current",
                            "stale",
                        ],
                    ),
                    required: true,
                    description: "Whether exact upstream inputs remain current.",
                ),
                "lineage": (
                    type: (
                        kind: "list",
                        items: (
                            kind: "string",
                            min_length: 1,
                            max_length: 256,
                        ),
                        min_items: 1,
                        max_items: 256,
                    ),
                    required: true,
                    description: "Sorted profile provenance identifiers.",
                ),
                "lock": (
                    type: (
                        kind: "symbol",
                        values: [
                            "locked",
                            "unlocked",
                        ],
                    ),
                    required: true,
                    description: "Author lock state.",
                ),
                "proposal_sha256": (
                    type: (
                        kind: "string",
                        min_length: 64,
                        max_length: 64,
                    ),
                    required: true,
                    description: "Exact allocation proposal fingerprint.",
                ),
                "rationale": (
                    type: (
                        kind: "string",
                        min_length: 1,
                        max_length: 2048,
                    ),
                    required: false,
                    description: "Explanation retained for non-trivial value states.",
                ),
                "review": (
                    type: (
                        kind: "symbol",
                        values: [
                            "accepted",
                            "not_required",
                            "pending",
                            "rejected",
