        },
        "unconventionality": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        }
      }
    },
    "TraitEvidence": {
      "kind": "object",
      "fields": {
        "confidence": {
          "type": {
            "kind": "symbol",
            "values": [
              "high",
              "low",
              "moderate",
              "unknown"
            ]
          },
          "required": true,
          "description": "Confidence in this representation."
        },
        "form": {
          "type": {
            "kind": "symbol",
            "values": [
              "high",
              "low",
              "middle",
              "score",
              "very_high",
              "very_low"
            ]
          },
          "required": true,
          "description": "Exact numeric input form or the retained five-band input form."
        },
        "freshness": {
          "type": {
            "kind": "symbol",
            "values": [
              "current",
              "stale"
            ]
          },
          "required": true,
          "description": "Whether exact upstream inputs remain current."
        },
        "lineage": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 1,
            "max_items": 256
          },
          "required": true,
          "description": "Sorted profile provenance identifiers."
        },
        "lock": {
          "type": {
            "kind": "symbol",
            "values": [
              "locked",
              "unlocked"
            ]
          },
