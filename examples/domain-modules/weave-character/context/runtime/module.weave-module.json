{
  "contract_version": 1,
  "pack_format_version": 1,
  "id": "org.weave.character",
  "version": "1.1.0",
  "namespace": "character",
  "title": "Weave Character",
  "summary": "Typed, provenance-aware Character Profiles with canonical HEXACO evidence and a visibly lossy derived OCEAN view.",
  "authors": [
    {
      "name": "Weave Contributors",
      "url": "https://github.com/chrisgliddon/weave"
    }
  ],
  "license": "MIT",
  "license_url": "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
  "weave_version": ">=0.1.0, <0.2.0",
  "capabilities": [
    {
      "id": "data",
      "version": 1
    },
    {
      "id": "editor_schema",
      "version": 1
    }
  ],
  "dependencies": [],
  "types": {
    "Agreeableness": {
      "kind": "object",
      "fields": {
        "flexibility": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "forgivingness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "gentleness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "patience": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "summary": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical factor summary; absence is explicit missing data."
        }
      }
    },
    "AttributedText": {
      "kind": "object",
      "fields": {
        "confidence": {
          "type": {
            "kind": "symbol",
            "values": [
              "high",
              "low",
              "moderate",
              "unknown"
            ]
          },
          "required": true,
          "description": "Confidence in this representation."
        },
        "freshness": {
          "type": {
            "kind": "symbol",
            "values": [
              "current",
              "stale"
            ]
          },
          "required": true,
          "description": "Whether exact upstream inputs remain current."
        },
        "lineage": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 1,
            "max_items": 256
          },
          "required": true,
          "description": "Sorted profile provenance identifiers."
        },
        "lock": {
          "type": {
            "kind": "symbol",
            "values": [
              "locked",
              "unlocked"
            ]
          },
          "required": true,
          "description": "Author lock state."
        },
        "rationale": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 2048
          },
          "required": false,
          "description": "Explanation retained for non-trivial value states."
        },
        "review": {
          "type": {
            "kind": "symbol",
            "values": [
              "accepted",
              "not_required",
              "pending",
              "rejected"
            ]
          },
          "required": true,
          "description": "Editorial review state."
        },
        "state": {
          "type": {
            "kind": "symbol",
            "values": [
              "authored",
              "derived",
              "imported",
              "overridden",
              "reviewed",
              "suggested"
            ]
          },
          "required": true,
          "description": "How the value entered the record."
        },
        "value": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 256
          },
          "required": true,
          "description": "Authored or reviewed text value."
        }
      }
    },
    "CharacterDateContext": {
      "kind": "object",
      "fields": {
        "accepted_record_ids": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 128
            },
            "min_items": 0,
            "max_items": 65536
          },
          "required": true,
          "description": "Sorted temporal records with accepted cues; empty means no reviewed cue was accepted."
        },
        "canonical_personality_write_back": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Always false; temporal context is never personality evidence."
        },
        "cues": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "CharacterDateCue"
            },
            "min_items": 0,
            "max_items": 16384
          },
          "required": true,
          "description": "Reviewed fictional cues in stable candidate-id order."
        },
        "packs": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "named",
              "name": "CharacterDatePack"
            },
            "min_items": 1,
            "max_items": 4096
          },
          "required": true,
          "description": "Exact context pack coordinates retained by the review."
        }
      }
    },
    "CharacterDateCue": {
      "kind": "object",
      "fields": {
        "content": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 2048
          },
          "required": true,
          "description": "Reviewed fictional authoring cue."
        },
        "cue_source_ids": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 1,
            "max_items": 4096
          },
          "required": true,
          "description": "Lineage for the fictional cue and declared ranking vector."
        },
        "decision": {
          "type": {
            "kind": "symbol",
            "values": [
              "accepted",
              "auto_approved",
              "edited",
              "overridden"
            ]
          },
          "required": true,
          "description": "Exact review path by which the cue entered the public view."
        },
        "fact_source_ids": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 1,
            "max_items": 4096
          },
          "required": true,
          "description": "Separate lineage for the matched dated fact."
        },
        "id": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Stable accepted cue identity."
        },
        "kind": {
          "type": {
            "kind": "symbol",
            "values": [
              "affinity",
              "memory",
              "tension",
              "value",
              "voice"
            ]
          },
          "required": true,
          "description": "Fictional authoring surface affected by this pending cue."
        },
        "pack_id": {
          "type": {
            "kind": "string",
            "min_length": 3,
            "max_length": 256
          },
          "required": true,
          "description": "Owning exact context pack identity."
        },
        "record_id": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Matched temporal record identity."
        },
        "relevance": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "required": true,
          "description": "Deterministic fixed-point relevance exposed as a normalized number."
        },
        "review_sha256": {
          "type": {
            "kind": "string",
            "min_length": 64,
            "max_length": 64
          },
          "required": true,
          "description": "Exact complete review fingerprint."
        },
        "sensitivity": {
          "type": {
            "kind": "symbol",
            "values": [
              "high",
              "low",
              "moderate"
            ]
          },
          "required": true,
          "description": "Review sensitivity retained from the source record."
        },
        "uncertainty": {
          "type": {
            "kind": "symbol",
            "values": [
              "bounded",
              "disputed",
              "exact"
            ]
          },
          "required": true,
          "description": "Bounded fact uncertainty retained independently from relevance."
        }
      }
    },
    "CharacterDatePack": {
      "kind": "object",
      "fields": {
        "id": {
          "type": {
            "kind": "string",
            "min_length": 3,
            "max_length": 256
          },
          "required": true,
          "description": "Exact temporal context pack identity."
        },
        "sha256": {
          "type": {
            "kind": "string",
            "min_length": 64,
            "max_length": 64
          },
          "required": true,
          "description": "Exact lowercase pack content SHA-256."
        },
        "version": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 256
          },
          "required": true,
          "description": "Exact temporal context pack version."
        }
      }
    },
    "CharacterIdentity": {
      "kind": "object",
      "fields": {
        "aliases": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 0,
            "max_items": 256
          },
          "required": true,
          "description": "Ordered aliases, empty when no aliases are asserted."
        },
        "display_name": {
          "type": {
            "kind": "named",
            "name": "AttributedText"
          },
          "required": true,
          "description": "Primary display name with authority and lineage."
        },
        "id": {
          "type": {
            "kind": "string",
            "min_length": 3,
            "max_length": 256
          },
          "required": true,
          "description": "Stable namespaced character identifier."
        }
      }
    },
    "CharacterProfile": {
      "kind": "object",
      "fields": {
        "date_context": {
          "type": {
            "kind": "named",
            "name": "CharacterDateContext"
          },
          "required": false,
          "description": "Optional reviewed, non-causal temporal authoring context."
        },
        "hexaco": {
          "type": {
            "kind": "named",
            "name": "HexacoProfile"
          },
          "required": true,
          "description": "Canonical six-factor, 24-facet HEXACO evidence."
        },
        "identity": {
          "type": {
            "kind": "named",
            "name": "CharacterIdentity"
          },
          "required": true,
          "description": "Stable identity separated from optional presentation."
        },
        "ocean": {
          "type": {
            "kind": "named",
            "name": "OceanView"
          },
          "required": true,
          "description": "Lossy and read-only OCEAN compatibility view."
        },
        "profile_format_version": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 1.0
          },
          "required": true,
          "description": "Exact Character Profile contract version."
        },
        "provenance": {
          "type": {
            "kind": "named",
            "name": "CharacterProvenance"
          },
          "required": true,
          "description": "Profile source and transformation identifiers."
        }
      }
    },
    "CharacterProvenance": {
      "kind": "object",
      "fields": {
        "sources": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 1,
            "max_items": 4096
          },
          "required": true,
          "description": "Sorted source identifiers retained from the profile."
        },
        "transformations": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 256
            },
            "min_items": 0,
            "max_items": 4096
          },
          "required": true,
          "description": "Sorted transformation identifiers retained from the profile."
        }
      }
    },
    "Conscientiousness": {
      "kind": "object",
      "fields": {
        "diligence": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "organization": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "perfectionism": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "prudence": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "summary": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical factor summary; absence is explicit missing data."
        }
      }
    },
    "Emotionality": {
      "kind": "object",
      "fields": {
        "anxiety": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "dependence": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "fearfulness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "sentimentality": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "summary": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical factor summary; absence is explicit missing data."
        }
      }
    },
    "Extraversion": {
      "kind": "object",
      "fields": {
        "liveliness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "sociability": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "social_boldness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "social_self_esteem": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "summary": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical factor summary; absence is explicit missing data."
        }
      }
    },
    "HexacoProfile": {
      "kind": "object",
      "fields": {
        "agreeableness": {
          "type": {
            "kind": "named",
            "name": "Agreeableness"
          },
          "required": true,
          "description": "Agreeableness factor and four facets."
        },
        "conscientiousness": {
          "type": {
            "kind": "named",
            "name": "Conscientiousness"
          },
          "required": true,
          "description": "Conscientiousness factor and four facets."
        },
        "emotionality": {
          "type": {
            "kind": "named",
            "name": "Emotionality"
          },
          "required": true,
          "description": "Emotionality factor and four facets."
        },
        "extraversion": {
          "type": {
            "kind": "named",
            "name": "Extraversion"
          },
          "required": true,
          "description": "Extraversion factor and four facets."
        },
        "honesty_humility": {
          "type": {
            "kind": "named",
            "name": "HonestyHumility"
          },
          "required": true,
          "description": "Honesty-Humility factor and four facets."
        },
        "openness": {
          "type": {
            "kind": "named",
            "name": "Openness"
          },
          "required": true,
          "description": "Openness to Experience factor and four facets."
        }
      }
    },
    "HonestyHumility": {
      "kind": "object",
      "fields": {
        "fairness": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "greed_avoidance": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "modesty": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "sincerity": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical HEXACO facet evidence; absence is never imputed."
        },
        "summary": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
          "required": false,
          "description": "Optional canonical factor summary; absence is explicit missing data."
        }
      }
    },
    "OceanDimension": {
      "kind": "object",
      "fields": {
        "confidence": {
          "type": {
            "kind": "symbol",
            "values": [
              "high",
              "low",
              "moderate",
              "unknown"
            ]
          },
          "required": true,
          "description": "Minimum confidence of the exact HEXACO inputs."
        },
        "input_paths": {
          "type": {
            "kind": "list",
            "items": {
              "kind": "string",
              "min_length": 1,
              "max_length": 512
            },
            "min_items": 1,
            "max_items": 4
          },
          "required": true,
          "description": "Exact canonical HEXACO input paths."
        },
        "score": {
          "type": {
            "kind": "number",
            "integer": false,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "required": true,
          "description": "Deterministically projected compatibility score."
        }
      }
    },
    "OceanView": {
      "kind": "object",
      "fields": {
        "agreeableness": {
          "type": {
            "kind": "named",
            "name": "OceanDimension"
          },
          "required": false,
          "description": "Optional derived dimension; absent when required canonical inputs are missing."
        },
        "algorithm": {
          "type": {
            "kind": "string",
            "min_length": 1,
            "max_length": 128
          },
          "required": true,
          "description": "Stable projection algorithm identifier."
        },
        "algorithm_version": {
          "type": {
            "kind": "number",
            "integer": true,
            "minimum": 1.0,
            "maximum": 1.0
          },
          "required": true,
          "description": "Exact projection algorithm version."
        },
        "conscientiousness": {
          "type": {
            "kind": "named",
            "name": "OceanDimension"
          },
          "required": false,
          "description": "Optional derived dimension; absent when required canonical inputs are missing."
        },
        "extraversion": {
          "type": {
            "kind": "named",
            "name": "OceanDimension"
          },
          "required": false,
          "description": "Optional derived dimension; absent when required canonical inputs are missing."
        },
        "independent_evidence": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Always false; this view is not independent personality evidence."
        },
        "lossy": {
          "type": {
            "kind": "bool"
          },
          "required": true,
          "description": "Always true for the five-factor compatibility projection."
        },
        "neuroticism": {
          "type": {
            "kind": "named",
            "name": "OceanDimension"
          },
          "required": false,
          "description": "Optional derived dimension; absent when required canonical inputs are missing."
        },
        "omitted_factor": {
          "type": {
            "kind": "symbol",
            "values": [
              "honesty_humility"
            ]
          },
          "required": true,
          "description": "Canonical HEXACO factor omitted by OCEAN."
        },
        "openness": {
          "type": {
            "kind": "named",
            "name": "OceanDimension"
          },
          "required": false,
          "description": "Optional derived dimension; absent when required canonical inputs are missing."
        }
      }
    },
    "Openness": {
      "kind": "object",
      "fields": {
        "aesthetic_appreciation": {
          "type": {
            "kind": "named",
            "name": "TraitEvidence"
          },
