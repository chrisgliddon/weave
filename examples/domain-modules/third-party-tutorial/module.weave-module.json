{
  "contract_version": 1,
  "pack_format_version": 1,
  "id": "dev.weave.lantern_weather",
  "version": "1.0.0",
  "namespace": "weather",
  "title": "Lantern Weather",
  "summary": "A tiny original weather module built with Weave's public declarative contract.",
  "authors": [
    {
      "name": "Weave Contributors",
      "url": "https://github.com/chrisgliddon/weave"
    }
  ],
  "license": "MIT",
  "license_url": "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
  "weave_version": ">=0.1.0, <0.2.0",
  "capabilities": [
    {
      "id": "data",
      "version": 1
    },
    {
      "id": "editor_schema",
      "version": 1
    }
  ],
  "dependencies": [],
  "types": {
    "Condition": {
      "kind": "symbol",
      "values": [
        "clear",
        "rain",
        "snow"
      ]
    }
  },
  "exports": {
    "condition": {
      "type": {
        "kind": "named",
        "name": "Condition"
      },
      "required": true,
      "source": "pack",
      "description": "The authored weather condition."
    },
    "temperature_c": {
      "type": {
        "kind": "number",
        "integer": false,
        "minimum": -40.0,
        "maximum": 60.0
      },
      "required": true,
      "source": "pack",
      "description": "The authored temperature in degrees Celsius."
    }
  },
  "provenance": {
    "sources": [
      {
        "id": "tutorial_original",
        "kind": "original",
        "url": "https://github.com/chrisgliddon/weave",
        "revision": "domain-tutorial-v1",
        "license": "MIT",
        "license_url": "https://github.com/chrisgliddon/weave/blob/main/LICENSE",
        "attribution": "Original fictional tutorial data authored for Weave.",
        "modified": false
      }
    ],
    "transformations": [],
    "claims": {
      "exports.condition": [
        "tutorial_original"
      ],
      "exports.temperature_c": [
        "tutorial_original"
      ],
      "types.Condition": [
        "tutorial_original"
      ]
    }
  }
}
