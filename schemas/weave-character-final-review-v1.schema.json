{
  "$defs": {
    "AcceptedDateContextCue": {
      "additionalProperties": false,
      "description": "One reviewed fictional cue exposed to narrative logic without writing into canon.",
      "properties": {
        "content": {
          "type": "string"
        },
        "cue_source_ids": {
          "description": "Public or original lineage for the fictional cue and its declared ranking vector.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/DateContextDecision"
        },
        "fact_source_ids": {
          "description": "Public lineage for the matched dated fact; never used as personality evidence.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DateContextCueKind"
        },
        "pack": {
          "$ref": "#/$defs/DateContextPackRef"
        },
        "record_id": {
          "type": "string"
        },
        "relevance": {
          "format": "double",
          "type": "number"
        },
        "review_sha256": {
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/DateContextSensitivity"
        },
        "source_ids": {
          "description": "Sorted union of fact and cue lineage retained for compatibility.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uncertainty": {
          "$ref": "#/$defs/DateContextUncertainty"
        }
      },
      "required": [
        "id",
        "record_id",
        "pack",
        "kind",
        "content",
        "relevance",
        "uncertainty",
        "sensitivity",
        "decision",
        "fact_source_ids",
        "cue_source_ids",
        "source_ids",
        "review_sha256"
      ],
      "type": "object"
    },
    "AlignmentPackRef": {
      "additionalProperties": false,
      "description": "Exact alignment-pack coordinate retained by a reviewed public view.",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "AlignmentPublicDecision": {
      "description": "Review path by which an alignment value entered the approved public view.",
      "enum": [
        "reviewed",
        "edited",
        "overridden"
      ],
      "type": "string"
    },
    "AlignmentView": {
      "additionalProperties": false,
      "description": "One reviewed, pluggable alignment view with declared authority and rationale in its header.",
      "properties": {
        "applied_sha256": {
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pack": {
          "$ref": "#/$defs/AlignmentPackRef"
        },
        "review_sha256": {
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/ApprovedAlignmentValue"
          },
          "description": "Approved public values keyed by stable axis identifier. Review traces stay in receipts.",
          "type": "object"
        },
        "view_id": {
          "type": "string"
        }
      },
      "required": [
        "view_id",
        "pack",
        "values",
        "input_paths",
        "review_sha256",
        "applied_sha256"
      ],
      "type": "object"
    },
    "ApprovedAlignmentValue": {
      "additionalProperties": false,
      "description": "One approved narrative alignment value. It is shorthand, never diagnostic evidence.",
      "properties": {
        "coverage_micros": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "decision": {
          "$ref": "#/$defs/AlignmentPublicDecision"
        },
        "explanation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "label_id": {
          "type": "string"
        },
        "score_micros": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label_id",
        "label",
        "decision",
        "coverage_micros",
        "explanation",
        "input_paths"
      ],
      "type": "object"
    },
    "Attributed": {
      "additionalProperties": false,
      "description": "A value together with authority, review, locking, freshness, confidence, and lineage.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "Confidence in the representation, not a claim of objective truth."
        },
        "freshness": {
          "$ref": "#/$defs/Freshness",
          "description": "Whether an upstream input changed after this value was produced."
        },
        "lineage": {
          "description": "Sorted source or transformation identifiers from profile provenance.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lock": {
          "$ref": "#/$defs/LockState",
          "description": "Whether ordinary synthesis operations may replace the field."
        },
        "rationale": {
          "description": "Required explanation for derived, suggested, reviewed, or overridden values.",
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState",
          "description": "Editorial review state."
        },
        "state": {
          "$ref": "#/$defs/ValueState",
          "description": "How this value entered the record."
        },
        "value": {
          "description": "Typed value.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "state",
        "confidence",
        "review",
        "lock",
        "freshness",
        "lineage"
      ],
      "type": "object"
    },
