            "calendar": {
              "$ref": "#/$defs/Calendar"
            },
            "day": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "month": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "precision": {
              "const": "full",
              "type": "string"
            },
            "year": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "precision",
            "calendar",
            "year",
            "month",
            "day"
          ],
          "type": "object"
        }
      ]
    },
    "Calendar": {
      "description": "Closed v1 calendar vocabulary. New calendars require a versioned extension.",
