    "BirthDate": {
      "description": "Date-only birth data with no fabricated components.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Known year; month and day remain unknown.",
          "properties": {
            "calendar": {
              "$ref": "#/$defs/Calendar"
            },
            "precision": {
              "const": "year",
              "type": "string"
            },
            "year": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "precision",
            "calendar",
            "year"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Known recurring month and day; year remains unknown.",
          "properties": {
            "calendar": {
              "$ref": "#/$defs/Calendar"
            },
            "day": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "month": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "precision": {
              "const": "month_day",
              "type": "string"
            }
          },
          "required": [
            "precision",
            "calendar",
            "month",
            "day"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
