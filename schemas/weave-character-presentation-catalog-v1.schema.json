{
  "$defs": {
    "PresentationAssetKind": {
      "description": "Closed portable asset roles.",
      "enum": [
        "avatar",
        "portrait",
        "sprite",
        "model",
        "illustration"
      ],
      "type": "string"
    },
    "PresentationAssetReference": {
      "additionalProperties": false,
      "description": "One project-relative asset coordinate with optional content fingerprint.",
      "properties": {
        "alt_text": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PresentationAssetKind"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "media_type",
        "alt_text"
      ],
      "type": "object"
    },
    "PresentationCatalogEntry": {
      "additionalProperties": false,
      "description": "One presentation value together with transparent eligibility and capacity constraints.",
      "properties": {
        "capacity": {
          "description": "Maximum proposed allocations, after retained assignments consume capacity.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "eligible_character_ids": {
          "description": "Exact ids eligible for this entry. Eligibility is the union with `eligible_id_prefixes`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "eligible_id_prefixes": {
          "description": "Stable id prefixes eligible for this entry. No profile field is inspected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "excluded_character_ids": {
          "description": "Explicit exclusions take precedence over either eligible list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "slot_id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PresentationCatalogValue"
        }
      },
      "required": [
        "id",
        "slot_id",
        "label",
        "value"
      ],
      "type": "object"
    },
    "PresentationCatalogSlot": {
      "additionalProperties": false,
      "description": "One independently allocatable presentation slot.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/PresentationCatalogValueKind"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "value_kind"
      ],
      "type": "object"
    },
    "PresentationCatalogValue": {
      "description": "Closed values a presentation catalog may propose. None can modify identity or personality.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "category": {
              "type": "string"
            },
            "descriptor": {
              "type": "string"
            },
            "kind": {
              "const": "appearance",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "category",
            "descriptor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string"
            },
            "kind": {
              "const": "palette_color",
              "type": "string"
            },
            "palette_slot": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "palette_slot",
            "color"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "style_tag",
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tag"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "asset": {
              "$ref": "#/$defs/PresentationAssetReference"
            },
            "kind": {
              "const": "asset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationCatalogValueKind": {
      "description": "Closed portable value kinds used to reject incompatible catalog entries and overrides.",
      "enum": [
        "appearance",
        "palette_color",
        "style_tag",
        "asset"
      ],
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Machine-readable source lineage shared by manifests and packs.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Manifest or pack paths mapped to sorted source/transformation identifiers.",
          "type": "object"
        },
        "sources": {
          "description": "Public sources sorted by source identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "type": "array"
        },
        "transformations": {
          "description": "Documented transformations sorted by transformation identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceTransformation"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "claims"
      ],
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Source category used by provenance validation.",
      "oneOf": [
        {
          "const": "original",
          "description": "Original material authored for the artifact.",
          "type": "string"
        },
        {
          "const": "public_source",
          "description": "Unmodified compatibly licensed public source.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Material derived from one or more declared sources.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One public or original source.",
      "properties": {
        "attribution": {
          "description": "Attribution retained with redistributed data.",
          "type": "string"
        },
        "id": {
          "description": "Stable source identifier within this artifact.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "Source category."
        },
        "license": {
          "description": "SPDX license expression.",
          "type": "string"
        },
        "license_url": {
          "description": "HTTPS location of the applicable license text.",
          "type": "string"
        },
        "modified": {
          "description": "Whether the artifact changes or derives from this source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Immutable commit, tag, release, date, or authored revision.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 for externally acquired source content.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Public HTTPS source location.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license",
        "license_url",
        "attribution",
        "modified"
      ],
      "type": "object"
    },
    "ProvenanceTransformation": {
      "additionalProperties": false,
      "description": "One reviewable transformation from declared inputs.",
      "properties": {
        "description": {
          "description": "Human-readable, independently written transformation summary.",
          "type": "string"
        },
        "id": {
          "description": "Stable transformation identifier.",
          "type": "string"
        },
        "inputs": {
          "description": "Sorted source or prior-transformation identifiers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inputs",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "urn:weave:schema:character-presentation-catalog:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable, data-only catalog of explicitly eligible presentation values.",
  "properties": {
    "catalog_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "additionalProperties": {
        "$ref": "#/$defs/PresentationCatalogEntry"
      },
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "independently_authored": {
      "description": "Must be true for a distributable catalog.",
      "type": "boolean"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "slots": {
      "additionalProperties": {
        "$ref": "#/$defs/PresentationCatalogSlot"
      },
      "type": "object"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "catalog_format_version",
    "id",
    "version",
    "title",
    "description",
    "independently_authored",
    "license",
    "license_url",
    "slots",
    "entries",
    "provenance"
  ],
  "title": "Weave Character Presentation Catalog v1",
  "type": "object",
  "x-weave-character-presentation-version": 1
}
