{
  "$defs": {
    "Confidence": {
      "description": "Bounded confidence vocabulary shared by evidence and projections.",
      "enum": [
        "unknown",
        "low",
        "moderate",
        "high"
      ],
      "type": "string"
    },
    "DiagnosticSeverity": {
      "description": "Diagnostic severity vocabulary.",
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    },
    "Freshness": {
      "description": "Whether lineage still matches the exact upstream inputs.",
      "enum": [
        "current",
        "stale"
      ],
      "type": "string"
    },
    "LockState": {
      "description": "Author lock state.",
      "enum": [
        "unlocked",
        "locked"
      ],
      "type": "string"
    },
    "RelationshipConsent": {
      "additionalProperties": false,
      "description": "Explicit consent metadata used by project safeguards; absence never means consent.",
      "properties": {
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RelationshipConsentState"
        }
      },
      "required": [
        "state",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipConsentState": {
      "description": "Closed consent states. Only `affirmed` satisfies a consent-required safeguard.",
      "enum": [
        "affirmed",
        "not_applicable",
        "unknown",
        "withheld"
      ],
      "type": "string"
    },
    "RelationshipDate": {
      "additionalProperties": false,
      "description": "Proleptic-Gregorian date used only for graph validity and safeguards.",
      "properties": {
        "day": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "month": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "year": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "month",
        "day"
      ],
      "type": "object"
    },
    "RelationshipDiagnostic": {
      "additionalProperties": false,
      "description": "One static, value-redacting relationship diagnostic.",
      "properties": {
        "code": {
          "$ref": "#/$defs/RelationshipDiagnosticCode"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "type": "object"
    },
    "RelationshipDiagnosticCode": {
      "description": "Redaction-safe project diagnostic codes for relationship reconciliation.",
      "enum": [
        "R100",
        "R101",
        "R102",
        "R103",
        "R104",
        "R105",
        "R106",
        "R107",
        "R108",
        "R109",
        "R110",
        "R111",
        "R112",
        "R113"
      ],
      "type": "string"
    },
    "RelationshipDirectionality": {
      "description": "Direction semantics declared by a kind pack rather than inferred from labels.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "directed",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "symmetric",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inverse_kind_id": {
              "type": "string"
            },
            "mode": {
              "const": "inverse_paired",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "inverse_kind_id"
          ],
          "type": "object"
        }
      ]
    },
    "RelationshipEdge": {
      "additionalProperties": false,
      "description": "One portable relationship edge with explicit layer, review, lock, and lineage.",
      "properties": {
        "affinity_score_micros": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipConsent"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RelationshipEvidenceContribution"
          },
          "type": "array"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "id": {
          "type": "string"
        },
        "inverse_edge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lock": {
          "$ref": "#/$defs/LockState"
        },
        "notes": {
          "additionalProperties": {
            "$ref": "#/$defs/RelationshipNote"
          },
          "type": "object"
        },
        "origin": {
          "$ref": "#/$defs/RelationshipEdgeOrigin",
          "description": "Authored/imported facts, computed affinity, and narrative suggestions never collapse."
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "safeguard_exceptions": {
          "additionalProperties": {
            "$ref": "#/$defs/RelationshipSafeguardException"
          },
          "description": "Explicit author-reviewed safeguard exceptions keyed by stable local id.",
          "type": "object"
        },
        "source_character_id": {
          "type": "string"
        },
        "target_character_id": {
          "type": "string"
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipValidityPeriod"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source_character_id",
        "target_character_id",
        "kind",
        "confidence"
      ],
      "type": "object"
    },
    "RelationshipEdgeOrigin": {
      "description": "The authority layer of one relationship edge.",
      "oneOf": [
        {
          "enum": [
            "imported",
            "computed_affinity",
            "suggested_narrative",
            "reviewed_suggestion"
          ],
          "type": "string"
        },
        {
          "const": "authored",
          "description": "Direct author statement; the default preserves the original v1 edge contract.",
          "type": "string"
        }
      ]
    },
    "RelationshipEdgeView": {
      "additionalProperties": false,
      "description": "Stable list/inspect record including owning profile and kind semantics.",
      "properties": {
        "directionality": {
          "$ref": "#/$defs/RelationshipDirectionality"
        },
        "edge": {
          "$ref": "#/$defs/RelationshipEdge"
        },
        "family": {
          "$ref": "#/$defs/RelationshipKindFamily"
        },
        "owner_character_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_character_id",
        "edge",
        "family",
        "directionality"
      ],
      "type": "object"
    },
    "RelationshipEvidenceContribution": {
      "additionalProperties": false,
      "description": "One inspectable input contribution retained on computed or suggested edges.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "contribution_micros": {
          "format": "int32",
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_sha256": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationshipEvidenceKind"
        }
      },
      "required": [
        "id",
        "kind",
        "contribution_micros",
        "available",
        "input_paths",
        "input_sha256",
        "explanation"
      ],
      "type": "object"
    },
    "RelationshipEvidenceKind": {
      "description": "Approved evidence families supported by the offline affinity scorer.",
      "enum": [
        "trait_similarity",
        "preference_overlap",
        "shared_context",
        "existing_canon"
      ],
      "type": "string"
    },
    "RelationshipKindFamily": {
      "description": "Open-pack-compatible baseline families used by safeguards and presentation.",
      "enum": [
        "kinship",
        "friendship",
        "mentorship",
        "rivalry",
        "partnership",
        "affinity",
        "narrative",
        "custom"
      ],
      "type": "string"
    },
    "RelationshipKindPackRef": {
      "additionalProperties": false,
      "description": "Exact immutable relationship-kind pack coordinate.",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "RelationshipNote": {
      "additionalProperties": false,
      "description": "One author-facing note on an edge.",
      "properties": {
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "content",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipRepairAction": {
      "description": "Closed repair vocabulary; applying any repair requires a separate revision or review.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "add_inverse",
              "type": "string"
            },
            "edge": {
              "$ref": "#/$defs/RelationshipEdge"
            },
            "owner_character_id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "owner_character_id",
            "edge"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "remove_duplicate",
              "type": "string"
            },
            "edge_id": {
              "type": "string"
            },
            "owner_character_id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "owner_character_id",
            "edge_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "review_safeguard",
              "type": "string"
            },
            "diagnostic_code": {
              "$ref": "#/$defs/RelationshipDiagnosticCode"
            }
          },
          "required": [
            "action",
            "diagnostic_code"
          ],
          "type": "object"
        }
      ]
    },
    "RelationshipRepairSuggestion": {
      "additionalProperties": false,
      "description": "Advisory repair. Reconciliation never mutates the collection.",
      "properties": {
        "action": {
          "$ref": "#/$defs/RelationshipRepairAction"
        },
        "id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "rationale"
      ],
      "type": "object"
    },
    "RelationshipSafeguardException": {
      "additionalProperties": false,
      "description": "One retained project-safeguard exception. Codes use the public `R###` vocabulary.",
      "properties": {
        "code": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "code",
        "reviewer",
        "rationale",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipValidityPeriod": {
      "additionalProperties": false,
      "description": "Inclusive date bounds for a relationship assertion.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipDate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReviewState": {
      "description": "Explicit editorial state.",
      "enum": [
        "not_required",
        "pending",
        "accepted",
        "rejected"
      ],
      "type": "string"
    }
  },
  "$id": "urn:weave:schema:character-relationship-reconciliation:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic read-only graph audit and repair suggestions.",
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/RelationshipDiagnostic"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/RelationshipEdgeView"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string"
    },
    "kind_pack": {
      "$ref": "#/$defs/RelationshipKindPackRef"
    },
    "reference_date": {
      "$ref": "#/$defs/RelationshipDate"
    },
    "repairs": {
      "items": {
        "$ref": "#/$defs/RelationshipRepairSuggestion"
      },
      "type": "array"
    },
    "report_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "report_format_version",
    "id",
    "input_sha256",
    "kind_pack",
    "reference_date",
    "edges",
    "diagnostics",
    "repairs"
  ],
  "title": "Weave Character Relationship Reconciliation Report v1",
  "type": "object",
  "x-weave-character-relationship-version": 1
}
