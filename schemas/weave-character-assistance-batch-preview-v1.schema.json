{
  "$defs": {
    "AssistanceBatchBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_candidates": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_characters": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_input_chars": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_provider_calls": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximum_characters",
        "maximum_provider_calls",
        "maximum_candidates",
        "maximum_input_chars"
      ],
      "type": "object"
    },
    "AssistanceBatchFilter": {
      "additionalProperties": false,
      "description": "Explicit batch filter. Empty id and prefix lists mean every collection profile is eligible.",
      "properties": {
        "character_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fields_missing_suggestions": {
          "items": {
            "$ref": "#/$defs/AssistanceFieldKind"
          },
          "type": "array"
        },
        "id_prefixes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "character_ids",
        "id_prefixes",
        "fields_missing_suggestions"
      ],
      "type": "object"
    },
    "AssistanceBatchRequest": {
      "additionalProperties": false,
      "description": "Exact batch request. Rate limiting is deterministic: each resume call is one scheduling window.",
      "properties": {
        "batch_request_format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/AssistanceBatchBudget"
        },
        "cache_policy": {
          "$ref": "#/$defs/AssistanceCachePolicy"
        },
        "collection_id": {
          "type": "string"
        },
        "expected_collection_sha256": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/AssistanceFieldKind"
          },
          "type": "array"
        },
        "filter": {
          "$ref": "#/$defs/AssistanceBatchFilter"
        },
        "id": {
          "type": "string"
        },
        "included_inputs": {
          "items": {
            "$ref": "#/$defs/AssistanceInputField"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "provider": {
          "$ref": "#/$defs/AssistanceProviderRef"
        },
        "rate_limit_calls_per_resume": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "retry": {
          "$ref": "#/$defs/AssistanceRetryPolicy"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settings": {
          "$ref": "#/$defs/AssistanceSettings"
        },
        "template": {
          "$ref": "#/$defs/AssistanceTemplateRef"
        }
      },
      "required": [
        "batch_request_format_version",
        "id",
        "collection_id",
        "expected_collection_sha256",
        "template",
        "provider",
        "fields",
        "included_inputs",
        "settings",
        "filter",
        "budget",
        "retry",
        "rate_limit_calls_per_resume",
        "cache_policy",
        "provenance"
      ],
      "type": "object"
    },
    "AssistanceCachePolicy": {
      "enum": [
        "disabled",
        "job_local"
      ],
      "type": "string"
    },
    "AssistanceExpectedOutput": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/AssistanceFieldKind"
          },
          "type": "array"
        },
        "maximum_candidates_per_field": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_output_chars": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "response_format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schema_id": {
          "type": "string"
        }
      },
      "required": [
        "response_format_version",
        "schema_id",
        "fields",
        "maximum_candidates_per_field",
        "maximum_output_chars"
      ],
      "type": "object"
    },
    "AssistanceFieldKind": {
      "description": "One requested development surface. Each variant has its own typed candidate value.",
      "enum": [
        "biography",
        "motivation",
        "fear",
        "guarded_truth",
        "tension",
        "narrative_hook",
        "presentation_cue",
        "role_idea",
        "relationship_cue",
        "context_reaction",
        "expression_example"
      ],
      "type": "string"
    },
    "AssistanceInputField": {
      "description": "Closed profile input surfaces which may be disclosed by an explicit request.",
      "enum": [
        "display_name",
        "aliases",
        "personality",
        "inner_life",
        "voice",
        "birth_context",
        "presentation",
        "projections",
        "relationships",
        "date_context",
        "expression"
      ],
      "type": "string"
    },
    "AssistancePreview": {
      "additionalProperties": false,
      "description": "Dry-run artifact. `provider_called` must remain false in every valid preview.",
      "properties": {
        "credential_value_stored": {
          "type": "boolean"
        },
        "expected_output": {
          "$ref": "#/$defs/AssistanceExpectedOutput"
        },
        "payload": {
          "$ref": "#/$defs/AssistanceProviderPayload"
        },
        "preview_format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider_called": {
          "type": "boolean"
        },
        "request": {
          "$ref": "#/$defs/AssistanceRequest"
        },
        "request_sha256": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AssistanceScopePreview"
        },
        "template_sha256": {
          "type": "string"
        }
      },
      "required": [
        "preview_format_version",
        "request",
        "request_sha256",
        "template_sha256",
        "scope",
        "payload",
        "expected_output",
        "provider_called",
        "credential_value_stored"
      ],
      "type": "object"
    },
    "AssistanceProviderFailureCode": {
      "enum": [
        "unavailable",
        "rate_limited",
        "timeout",
        "authentication",
        "budget",
        "internal"
      ],
      "type": "string"
    },
    "AssistanceProviderMode": {
      "enum": [
        "offline",
        "external"
      ],
      "type": "string"
    },
    "AssistanceProviderPayload": {
      "additionalProperties": false,
      "description": "Provider-neutral payload created from the visible scope preview.",
      "properties": {
        "expected_response_schema": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/AssistanceFieldKind"
          },
          "type": "array"
        },
        "generation": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "included_values": {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "$ref": "#/$defs/DomainValue"
            },
            "birth_context": {
              "$ref": "#/$defs/DomainValue"
            },
            "date_context": {
              "$ref": "#/$defs/DomainValue"
            },
            "display_name": {
              "$ref": "#/$defs/DomainValue"
            },
            "expression": {
              "$ref": "#/$defs/DomainValue"
            },
            "inner_life": {
              "$ref": "#/$defs/DomainValue"
            },
            "personality": {
              "$ref": "#/$defs/DomainValue"
            },
            "presentation": {
              "$ref": "#/$defs/DomainValue"
            },
            "projections": {
              "$ref": "#/$defs/DomainValue"
            },
            "relationships": {
              "$ref": "#/$defs/DomainValue"
            },
            "voice": {
              "$ref": "#/$defs/DomainValue"
            }
          },
          "type": "object"
        },
        "instructions": {
          "additionalProperties": false,
          "properties": {
            "biography": {
              "type": "string"
            },
            "context_reaction": {
              "type": "string"
            },
            "expression_example": {
              "type": "string"
            },
            "fear": {
              "type": "string"
            },
            "guarded_truth": {
              "type": "string"
            },
            "motivation": {
              "type": "string"
            },
            "narrative_hook": {
              "type": "string"
            },
            "presentation_cue": {
              "type": "string"
            },
            "relationship_cue": {
              "type": "string"
            },
            "role_idea": {
              "type": "string"
            },
            "tension": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "known_character_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "payload_format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "profile_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "required_evidence": {
          "additionalProperties": false,
          "properties": {
            "biography": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "context_reaction": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "expression_example": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "fear": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "guarded_truth": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "motivation": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "narrative_hook": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "presentation_cue": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "relationship_cue": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "role_idea": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tension": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settings": {
          "$ref": "#/$defs/AssistanceSettings"
        }
      },
      "required": [
        "payload_format_version",
        "request_id",
        "profile_id",
        "fields",
        "instructions",
        "required_evidence",
        "included_values",
        "known_character_ids",
        "settings",
        "generation",
        "expected_response_schema"
      ],
      "type": "object"
    },
    "AssistanceProviderRef": {
      "additionalProperties": false,
      "description": "Exact provider adapter coordinate and declared execution capabilities.",
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "credential_required": {
          "type": "boolean"
        },
        "engine_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/AssistanceProviderMode"
        },
        "supports_seed": {
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "engine_id",
        "mode",
        "supports_seed",
        "credential_required"
      ],
      "type": "object"
    },
    "AssistanceRequest": {
      "additionalProperties": false,
      "description": "Exact single-profile generation request. Credentials have no serialized field.",
      "properties": {
        "expected_profile_sha256": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/AssistanceFieldKind"
          },
          "type": "array"
        },
        "generation": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "included_inputs": {
          "items": {
            "$ref": "#/$defs/AssistanceInputField"
          },
          "type": "array"
        },
        "profile_id": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "provider": {
          "$ref": "#/$defs/AssistanceProviderRef"
        },
        "request_format_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settings": {
          "$ref": "#/$defs/AssistanceSettings"
        },
        "template": {
          "$ref": "#/$defs/AssistanceTemplateRef"
        }
      },
      "required": [
        "request_format_version",
        "id",
        "profile_id",
        "expected_profile_sha256",
        "template",
        "provider",
        "fields",
        "included_inputs",
        "settings",
        "generation",
        "provenance"
      ],
      "type": "object"
    },
    "AssistanceRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_retries_per_character": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "retryable_codes": {
          "items": {
            "$ref": "#/$defs/AssistanceProviderFailureCode"
          },
          "type": "array"
        }
      },
      "required": [
        "maximum_retries_per_character",
        "retryable_codes"
      ],
      "type": "object"
    },
    "AssistanceScopePreview": {
      "additionalProperties": false,
      "description": "Exact authoring values visible before any provider adapter is invoked.",
      "properties": {
        "included_values": {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "$ref": "#/$defs/DomainValue"
            },
            "birth_context": {
              "$ref": "#/$defs/DomainValue"
            },
            "date_context": {
              "$ref": "#/$defs/DomainValue"
            },
            "display_name": {
              "$ref": "#/$defs/DomainValue"
            },
            "expression": {
              "$ref": "#/$defs/DomainValue"
            },
            "inner_life": {
              "$ref": "#/$defs/DomainValue"
            },
            "personality": {
              "$ref": "#/$defs/DomainValue"
            },
            "presentation": {
              "$ref": "#/$defs/DomainValue"
            },
            "projections": {
              "$ref": "#/$defs/DomainValue"
            },
            "relationships": {
              "$ref": "#/$defs/DomainValue"
            },
            "voice": {
              "$ref": "#/$defs/DomainValue"
            }
          },
          "type": "object"
        },
        "input_profile_sha256": {
          "type": "string"
        },
        "known_character_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile_id": {
          "type": "string"
        },
        "serialized_character_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "input_profile_sha256",
        "included_values",
        "known_character_ids",
        "serialized_character_count"
      ],
      "type": "object"
    },
    "AssistanceSettings": {
      "additionalProperties": false,
      "description": "Serializable settings are deliberately credential-free.",
      "properties": {
        "candidates_per_field": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "creativity_micros": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "maximum_output_chars": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "provider_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/DomainValue"
          },
          "type": "object"
        }
      },
      "required": [
        "candidates_per_field",
        "language",
        "creativity_micros",
        "maximum_output_chars"
      ],
      "type": "object"
    },
    "AssistanceTemplateRef": {
      "additionalProperties": false,
      "description": "Exact template coordinate pinned by every request.",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "DomainValue": {
      "description": "Unambiguous portable value representation shared by RON and JSON.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Explicit null.",
          "properties": {
            "kind": {
              "const": "null",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boolean.",
          "properties": {
            "kind": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite number.",
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "UTF-8 text.",
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Meaning-bearing atom.",
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered values.",
          "properties": {
            "kind": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DomainValue"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Closed string-keyed value.",
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DomainValue"
              },
              "type": "object"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Machine-readable source lineage shared by manifests and packs.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Manifest or pack paths mapped to sorted source/transformation identifiers.",
          "type": "object"
        },
        "sources": {
          "description": "Public sources sorted by source identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "type": "array"
        },
        "transformations": {
          "description": "Documented transformations sorted by transformation identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceTransformation"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "claims"
      ],
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Source category used by provenance validation.",
      "oneOf": [
        {
          "const": "original",
          "description": "Original material authored for the artifact.",
          "type": "string"
        },
        {
          "const": "public_source",
          "description": "Unmodified compatibly licensed public source.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Material derived from one or more declared sources.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One public or original source.",
      "properties": {
        "attribution": {
          "description": "Attribution retained with redistributed data.",
          "type": "string"
        },
        "id": {
          "description": "Stable source identifier within this artifact.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "Source category."
        },
        "license": {
          "description": "SPDX license expression.",
          "type": "string"
        },
        "license_url": {
          "description": "HTTPS location of the applicable license text.",
          "type": "string"
        },
        "modified": {
          "description": "Whether the artifact changes or derives from this source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Immutable commit, tag, release, date, or authored revision.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 for externally acquired source content.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Public HTTPS source location.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license",
        "license_url",
        "attribution",
        "modified"
      ],
      "type": "object"
    },
    "ProvenanceTransformation": {
      "additionalProperties": false,
      "description": "One reviewable transformation from declared inputs.",
      "properties": {
        "description": {
          "description": "Human-readable, independently written transformation summary.",
          "type": "string"
        },
        "id": {
          "description": "Stable transformation identifier.",
          "type": "string"
        },
        "inputs": {
          "description": "Sorted source or prior-transformation identifiers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inputs",
        "description"
      ],
      "type": "object"
    }
