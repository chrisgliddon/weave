{
  "$defs": {
    "Confidence": {
      "description": "Bounded confidence vocabulary shared by evidence and projections.",
      "enum": [
        "unknown",
        "low",
        "moderate",
        "high"
      ],
      "type": "string"
    },
    "Freshness": {
      "description": "Whether lineage still matches the exact upstream inputs.",
      "enum": [
        "current",
        "stale"
      ],
      "type": "string"
    },
    "LockState": {
      "description": "Author lock state.",
      "enum": [
        "unlocked",
        "locked"
      ],
      "type": "string"
    },
    "RelationshipConsent": {
      "additionalProperties": false,
      "description": "Explicit consent metadata used by project safeguards; absence never means consent.",
      "properties": {
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RelationshipConsentState"
        }
      },
      "required": [
        "state",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipConsentState": {
      "description": "Closed consent states. Only `affirmed` satisfies a consent-required safeguard.",
      "enum": [
        "affirmed",
        "not_applicable",
        "unknown",
        "withheld"
      ],
      "type": "string"
    },
    "RelationshipDate": {
      "additionalProperties": false,
      "description": "Proleptic-Gregorian date used only for graph validity and safeguards.",
      "properties": {
        "day": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "month": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "year": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "month",
        "day"
      ],
      "type": "object"
    },
    "RelationshipDiagnosticCode": {
      "description": "Redaction-safe project diagnostic codes for relationship reconciliation.",
      "enum": [
        "R100",
        "R101",
        "R102",
        "R103",
        "R104",
        "R105",
        "R106",
        "R107",
        "R108",
        "R109",
        "R110",
        "R111",
        "R112",
        "R113"
      ],
      "type": "string"
    },
    "RelationshipEdge": {
      "additionalProperties": false,
      "description": "One portable relationship edge with explicit layer, review, lock, and lineage.",
      "properties": {
        "affinity_score_micros": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipConsent"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RelationshipEvidenceContribution"
          },
          "type": "array"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "id": {
          "type": "string"
        },
        "inverse_edge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lock": {
          "$ref": "#/$defs/LockState"
        },
        "notes": {
          "additionalProperties": {
            "$ref": "#/$defs/RelationshipNote"
          },
          "type": "object"
        },
        "origin": {
          "$ref": "#/$defs/RelationshipEdgeOrigin",
          "description": "Authored/imported facts, computed affinity, and narrative suggestions never collapse."
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "safeguard_exceptions": {
          "additionalProperties": {
            "$ref": "#/$defs/RelationshipSafeguardException"
          },
          "description": "Explicit author-reviewed safeguard exceptions keyed by stable local id.",
          "type": "object"
        },
        "source_character_id": {
          "type": "string"
        },
        "target_character_id": {
          "type": "string"
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipValidityPeriod"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source_character_id",
        "target_character_id",
        "kind",
        "confidence"
      ],
      "type": "object"
    },
    "RelationshipEdgeOrigin": {
      "description": "The authority layer of one relationship edge.",
      "oneOf": [
        {
          "enum": [
            "imported",
            "computed_affinity",
            "suggested_narrative",
            "reviewed_suggestion"
          ],
          "type": "string"
        },
        {
          "const": "authored",
          "description": "Direct author statement; the default preserves the original v1 edge contract.",
          "type": "string"
        }
      ]
    },
    "RelationshipEdgeRemoval": {
      "additionalProperties": false,
      "description": "Fingerprinted edge removal; locked edges require a deliberate reviewed override.",
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "expected_edge_sha256": {
          "type": "string"
        },
        "override_locked": {
          "type": "boolean"
        },
        "owner_character_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_character_id",
        "edge_id",
        "expected_edge_sha256",
        "override_locked"
      ],
      "type": "object"
    },
    "RelationshipEvidenceContribution": {
      "additionalProperties": false,
      "description": "One inspectable input contribution retained on computed or suggested edges.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "contribution_micros": {
          "format": "int32",
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_sha256": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationshipEvidenceKind"
        }
      },
      "required": [
        "id",
        "kind",
        "contribution_micros",
        "available",
        "input_paths",
        "input_sha256",
        "explanation"
      ],
      "type": "object"
    },
    "RelationshipEvidenceKind": {
      "description": "Approved evidence families supported by the offline affinity scorer.",
      "enum": [
        "trait_similarity",
        "preference_overlap",
        "shared_context",
        "existing_canon"
      ],
      "type": "string"
    },
    "RelationshipNote": {
      "additionalProperties": false,
      "description": "One author-facing note on an edge.",
      "properties": {
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "content",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipReviewDecision": {
      "description": "Explicit editorial disposition for one immutable relationship candidate.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "accept",
              "type": "string"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "decision",
            "lock"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "edit",
              "type": "string"
            },
            "edges": {
              "items": {
                "$ref": "#/$defs/RelationshipEdge"
              },
              "type": "array"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "edges",
            "lock",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "override",
              "type": "string"
            },
            "edges": {
              "items": {
                "$ref": "#/$defs/RelationshipEdge"
              },
              "type": "array"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": "string"
            },
            "replacements": {
              "items": {
                "$ref": "#/$defs/RelationshipEdgeRemoval"
              },
              "type": "array"
            }
          },
          "required": [
            "decision",
            "edges",
            "lock",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "exception",
              "type": "string"
            },
            "edges": {
              "items": {
                "$ref": "#/$defs/RelationshipEdge"
              },
              "type": "array"
            },
            "exception_codes": {
              "items": {
                "$ref": "#/$defs/RelationshipDiagnosticCode"
              },
              "type": "array"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": "string"
            },
            "replacements": {
              "items": {
                "$ref": "#/$defs/RelationshipEdgeRemoval"
              },
              "type": "array"
            }
          },
          "required": [
            "decision",
            "edges",
            "exception_codes",
            "lock",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "reject",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "withhold",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "rationale"
          ],
          "type": "object"
        }
      ]
    },
    "RelationshipSafeguardException": {
      "additionalProperties": false,
      "description": "One retained project-safeguard exception. Codes use the public `R###` vocabulary.",
      "properties": {
        "code": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "lineage": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rationale": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "code",
        "reviewer",
        "rationale",
        "lineage"
      ],
      "type": "object"
    },
    "RelationshipValidityPeriod": {
      "additionalProperties": false,
      "description": "Inclusive date bounds for a relationship assertion.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipDate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReviewState": {
      "description": "Explicit editorial state.",
      "enum": [
        "not_required",
        "pending",
        "accepted",
        "rejected"
      ],
      "type": "string"
    }
  },
  "$id": "urn:weave:schema:character-relationship-review:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete author decision map. Every proposal candidate requires one decision.",
  "properties": {
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/RelationshipReviewDecision"
      },
      "type": "object"
    },
    "proposal_sha256": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "review_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "reviewer": {
      "type": "string"
    }
  },
  "required": [
    "review_format_version",
    "proposal_sha256",
    "reviewer",
    "rationale",
    "decisions"
  ],
  "title": "Weave Character Relationship Review v1",
  "type": "object",
  "x-weave-character-relationship-version": 1
}
