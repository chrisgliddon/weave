{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Machine-readable source lineage shared by manifests and packs.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Manifest or pack paths mapped to sorted source/transformation identifiers.",
          "type": "object"
        },
        "sources": {
          "description": "Public sources sorted by source identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "type": "array"
        },
        "transformations": {
          "description": "Documented transformations sorted by transformation identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceTransformation"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "claims"
      ],
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Source category used by provenance validation.",
      "oneOf": [
        {
          "const": "original",
          "description": "Original material authored for the artifact.",
          "type": "string"
        },
        {
          "const": "public_source",
          "description": "Unmodified compatibly licensed public source.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Material derived from one or more declared sources.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One public or original source.",
      "properties": {
        "attribution": {
          "description": "Attribution retained with redistributed data.",
          "type": "string"
        },
        "id": {
          "description": "Stable source identifier within this artifact.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "Source category."
        },
        "license": {
          "description": "SPDX license expression.",
          "type": "string"
        },
        "license_url": {
          "description": "HTTPS location of the applicable license text.",
          "type": "string"
        },
        "modified": {
          "description": "Whether the artifact changes or derives from this source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Immutable commit, tag, release, date, or authored revision.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 for externally acquired source content.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Public HTTPS source location.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license",
        "license_url",
        "attribution",
        "modified"
      ],
      "type": "object"
    },
    "ProvenanceTransformation": {
      "additionalProperties": false,
      "description": "One reviewable transformation from declared inputs.",
      "properties": {
        "description": {
          "description": "Human-readable, independently written transformation summary.",
          "type": "string"
        },
        "id": {
          "description": "Stable transformation identifier.",
          "type": "string"
        },
        "inputs": {
          "description": "Sorted source or prior-transformation identifiers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inputs",
        "description"
      ],
      "type": "object"
    },
    "RelationshipDirectionality": {
      "description": "Direction semantics declared by a kind pack rather than inferred from labels.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "directed",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "symmetric",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inverse_kind_id": {
              "type": "string"
            },
            "mode": {
              "const": "inverse_paired",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "inverse_kind_id"
          ],
          "type": "object"
        }
      ]
    },
    "RelationshipKindDefinition": {
      "additionalProperties": false,
      "description": "One relationship kind and the structural metadata it requires.",
      "properties": {
        "allows_multiple_concurrent": {
          "type": "boolean"
        },
        "allows_self": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "directionality": {
          "$ref": "#/$defs/RelationshipDirectionality"
        },
        "family": {
          "$ref": "#/$defs/RelationshipKindFamily"
        },
        "id": {
          "type": "string"
        },
        "kinship_semantics": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipKinshipSemantics"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_metadata": {
          "items": {
            "$ref": "#/$defs/RelationshipMetadataRequirement"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "family",
        "directionality",
        "allows_self",
        "allows_multiple_concurrent",
        "required_metadata",
        "limitations"
      ],
      "type": "object"
    },
    "RelationshipKindFamily": {
      "description": "Open-pack-compatible baseline families used by safeguards and presentation.",
      "enum": [
        "kinship",
        "friendship",
        "mentorship",
        "rivalry",
        "partnership",
        "affinity",
        "narrative",
        "custom"
      ],
      "type": "string"
    },
    "RelationshipKinshipSemantics": {
      "description": "Explicit pedigree meaning used for cycle and contradiction checks.",
      "enum": [
        "parent_of",
        "child_of",
        "sibling_of",
        "other"
      ],
      "type": "string"
    },
    "RelationshipMetadataRequirement": {
      "description": "Metadata a kind requires on every applied edge.",
      "enum": [
        "confidence",
        "validity",
        "notes",
        "consent",
        "evidence"
      ],
      "type": "string"
    }
  },
  "$id": "urn:weave:schema:character-relationship-kind-pack:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable, independently distributable vocabulary and semantics for relationship edges.",
  "properties": {
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "independently_authored": {
      "type": "boolean"
    },
    "kinds": {
      "additionalProperties": {
        "$ref": "#/$defs/RelationshipKindDefinition"
      },
      "type": "object"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "pack_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "pack_format_version",
    "id",
    "version",
    "title",
    "description",
    "independently_authored",
    "license",
    "license_url",
    "kinds",
    "provenance"
  ],
  "title": "Weave Character Relationship Kind Pack v1",
  "type": "object",
  "x-weave-character-relationship-version": 1
}
