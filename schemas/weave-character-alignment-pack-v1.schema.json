{
  "$defs": {
    "AlignmentAxis": {
      "additionalProperties": false,
      "description": "One signed weighted axis and its complete ordered label thresholds.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "format": "int16",
            "maximum": 32767,
            "minimum": -32768,
            "type": "integer"
          },
          "description": "Input weights in non-zero signed thousandths.",
          "type": "object"
        },
        "label": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/AlignmentThreshold"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "inputs",
        "thresholds",
        "limitations"
      ],
      "type": "object"
    },
    "AlignmentCalibrationExpected": {
      "additionalProperties": false,
      "description": "Exact expected score and label for one calibration axis.",
      "properties": {
        "label_id": {
          "type": "string"
        },
        "score_micros": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "score_micros",
        "label_id"
      ],
      "type": "object"
    },
    "AlignmentCalibrationFixture": {
      "additionalProperties": false,
      "description": "Synthetic calibration fixture proving exact fixed-point behavior for a complete pack.",
      "properties": {
        "description": {
          "type": "string"
        },
        "expected": {
          "additionalProperties": {
            "$ref": "#/$defs/AlignmentCalibrationExpected"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "inputs_micros": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "description",
        "inputs_micros",
        "expected"
      ],
      "type": "object"
    },
    "AlignmentInputField": {
      "additionalProperties": false,
      "description": "One declared canonical input. V1 deliberately permits only HEXACO factors and facets.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "profile_path": {
          "type": "string"
        },
        "trait_id": {
          "$ref": "#/$defs/HexacoTrait"
        }
      },
      "required": [
        "id",
        "trait_id",
        "profile_path",
        "label",
        "description"
      ],
      "type": "object"
    },
    "AlignmentPackProvider": {
      "description": "Exact provider identity for standalone and public domain-module packs.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "standalone",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content_sha256": {
              "type": "string"
            },
            "kind": {
              "const": "domain_module",
              "type": "string"
            },
            "module_id": {
              "type": "string"
            },
            "module_version": {
              "type": "string"
            },
            "pack_id": {
              "type": "string"
            },
            "pack_version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "module_id",
            "module_version",
            "pack_id",
            "pack_version",
            "content_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "AlignmentThreshold": {
      "additionalProperties": false,
      "description": "Inclusive upper bound assigning one neutral narrative label to a signed score.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "upper_bound_micros": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "upper_bound_micros",
        "description"
      ],
      "type": "object"
    },
    "HexacoTrait": {
      "description": "Stable identifiers for all six factors and 24 facets.",
      "enum": [
        "honesty_humility",
        "sincerity",
        "fairness",
        "greed_avoidance",
        "modesty",
        "emotionality",
        "fearfulness",
        "anxiety",
        "dependence",
        "sentimentality",
        "extraversion",
        "social_self_esteem",
        "social_boldness",
        "sociability",
        "liveliness",
        "agreeableness",
        "forgivingness",
        "gentleness",
        "flexibility",
        "patience",
        "conscientiousness",
        "organization",
        "diligence",
        "perfectionism",
        "prudence",
        "openness",
        "aesthetic_appreciation",
        "inquisitiveness",
        "creativity",
        "unconventionality"
      ],
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Machine-readable source lineage shared by manifests and packs.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Manifest or pack paths mapped to sorted source/transformation identifiers.",
          "type": "object"
        },
        "sources": {
          "description": "Public sources sorted by source identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "type": "array"
        },
        "transformations": {
          "description": "Documented transformations sorted by transformation identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceTransformation"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "claims"
      ],
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Source category used by provenance validation.",
      "oneOf": [
        {
          "const": "original",
          "description": "Original material authored for the artifact.",
          "type": "string"
        },
        {
          "const": "public_source",
          "description": "Unmodified compatibly licensed public source.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Material derived from one or more declared sources.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One public or original source.",
      "properties": {
        "attribution": {
          "description": "Attribution retained with redistributed data.",
          "type": "string"
        },
        "id": {
          "description": "Stable source identifier within this artifact.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "Source category."
        },
        "license": {
          "description": "SPDX license expression.",
          "type": "string"
        },
        "license_url": {
          "description": "HTTPS location of the applicable license text.",
          "type": "string"
        },
        "modified": {
          "description": "Whether the artifact changes or derives from this source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Immutable commit, tag, release, date, or authored revision.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 for externally acquired source content.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Public HTTPS source location.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license",
        "license_url",
        "attribution",
        "modified"
      ],
      "type": "object"
    },
    "ProvenanceTransformation": {
      "additionalProperties": false,
      "description": "One reviewable transformation from declared inputs.",
      "properties": {
        "description": {
          "description": "Human-readable, independently written transformation summary.",
          "type": "string"
        },
        "id": {
          "description": "Stable transformation identifier.",
          "type": "string"
        },
        "inputs": {
          "description": "Sorted source or prior-transformation identifiers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inputs",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "urn:weave:schema:character-alignment-pack:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One separately distributable, data-only narrative alignment system.",
  "properties": {
    "axes": {
      "additionalProperties": {
        "$ref": "#/$defs/AlignmentAxis"
      },
      "type": "object"
    },
    "calibrations": {
      "additionalProperties": {
        "$ref": "#/$defs/AlignmentCalibrationFixture"
      },
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/AlignmentInputField"
      },
      "type": "object"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    },
    "methodology": {
      "type": "string"
    },
    "pack_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "provider": {
      "$ref": "#/$defs/AlignmentPackProvider"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "pack_format_version",
    "id",
    "version",
    "title",
    "license",
    "license_url",
    "methodology",
    "limitations",
    "provider",
    "inputs",
    "axes",
    "calibrations",
    "provenance"
  ],
  "title": "Weave Character Alignment Pack v1",
  "type": "object",
  "x-weave-character-alignment-version": 1
}
