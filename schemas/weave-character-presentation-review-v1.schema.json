{
  "$defs": {
    "LockState": {
      "description": "Author lock state.",
      "enum": [
        "unlocked",
        "locked"
      ],
      "type": "string"
    },
    "PresentationAssetKind": {
      "description": "Closed portable asset roles.",
      "enum": [
        "avatar",
        "portrait",
        "sprite",
        "model",
        "illustration"
      ],
      "type": "string"
    },
    "PresentationAssetReference": {
      "additionalProperties": false,
      "description": "One project-relative asset coordinate with optional content fingerprint.",
      "properties": {
        "alt_text": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PresentationAssetKind"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "media_type",
        "alt_text"
      ],
      "type": "object"
    },
    "PresentationCatalogValue": {
      "description": "Closed values a presentation catalog may propose. None can modify identity or personality.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "category": {
              "type": "string"
            },
            "descriptor": {
              "type": "string"
            },
            "kind": {
              "const": "appearance",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "category",
            "descriptor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string"
            },
            "kind": {
              "const": "palette_color",
              "type": "string"
            },
            "palette_slot": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "palette_slot",
            "color"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "style_tag",
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tag"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "asset": {
              "$ref": "#/$defs/PresentationAssetReference"
            },
            "kind": {
              "const": "asset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "type": "object"
        }
      ]
    },
    "PresentationReviewDecision": {
      "description": "Explicit editorial disposition of one proposed value.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "accept",
              "type": "string"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "decision",
            "lock"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Select another eligible entry from the same immutable catalog.",
          "properties": {
            "decision": {
              "const": "edit",
              "type": "string"
            },
            "entry_id": {
              "type": "string"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "entry_id",
            "lock",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Author a presentation-only value outside the catalog allocation.",
          "properties": {
            "decision": {
              "const": "override",
              "type": "string"
            },
            "lock": {
              "$ref": "#/$defs/LockState"
            },
            "rationale": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PresentationCatalogValue"
            }
          },
          "required": [
            "decision",
            "value",
            "lock",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "reject",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "rationale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "const": "withhold",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "decision",
            "rationale"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:weave:schema:character-presentation-review:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete decision map for every proposed character/slot pair.",
  "properties": {
    "decisions": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/PresentationReviewDecision"
        },
        "type": "object"
      },
      "type": "object"
    },
    "proposal_sha256": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "review_format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "reviewer": {
      "type": "string"
    }
  },
  "required": [
    "review_format_version",
    "proposal_sha256",
    "reviewer",
    "rationale",
    "decisions"
  ],
  "title": "Weave Character Presentation Review v1",
  "type": "object",
  "x-weave-character-presentation-version": 1
}
