{
  "$defs": {
    "DomainValue": {
      "description": "Unambiguous portable value representation shared by RON and JSON.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Explicit null.",
          "properties": {
            "kind": {
              "const": "null",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boolean.",
          "properties": {
            "kind": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite number.",
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "UTF-8 text.",
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Meaning-bearing atom.",
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered values.",
          "properties": {
            "kind": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DomainValue"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Closed string-keyed value.",
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DomainValue"
              },
              "type": "object"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ModuleRequirement": {
      "additionalProperties": false,
      "description": "Module requirement declared by a pack or project activation.",
      "properties": {
        "id": {
          "description": "Globally stable module identity.",
          "type": "string"
        },
        "version": {
          "description": "Accepted semantic versions.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "PackDependency": {
      "additionalProperties": false,
      "description": "One pack dependency.",
      "properties": {
        "module_id": {
          "description": "Owning module identity.",
          "type": "string"
        },
        "pack_id": {
          "description": "Pack identifier within that module.",
          "type": "string"
        },
        "version": {
          "description": "Accepted semantic versions.",
          "type": "string"
        }
      },
      "required": [
        "module_id",
        "pack_id",
        "version"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Machine-readable source lineage shared by manifests and packs.",
      "properties": {
        "claims": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Manifest or pack paths mapped to sorted source/transformation identifiers.",
          "type": "object"
        },
        "sources": {
          "description": "Public sources sorted by source identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "type": "array"
        },
        "transformations": {
          "description": "Documented transformations sorted by transformation identifier.",
          "items": {
            "$ref": "#/$defs/ProvenanceTransformation"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "transformations",
        "claims"
      ],
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Source category used by provenance validation.",
      "oneOf": [
        {
          "const": "original",
          "description": "Original material authored for the artifact.",
          "type": "string"
        },
        {
          "const": "public_source",
          "description": "Unmodified compatibly licensed public source.",
          "type": "string"
        },
        {
          "const": "derived",
          "description": "Material derived from one or more declared sources.",
          "type": "string"
        }
      ]
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One public or original source.",
      "properties": {
        "attribution": {
          "description": "Attribution retained with redistributed data.",
          "type": "string"
        },
        "id": {
          "description": "Stable source identifier within this artifact.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind",
          "description": "Source category."
        },
        "license": {
          "description": "SPDX license expression.",
          "type": "string"
        },
        "license_url": {
          "description": "HTTPS location of the applicable license text.",
          "type": "string"
        },
        "modified": {
          "description": "Whether the artifact changes or derives from this source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Immutable commit, tag, release, date, or authored revision.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 for externally acquired source content.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Public HTTPS source location.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url",
        "revision",
        "license",
        "license_url",
        "attribution",
        "modified"
      ],
      "type": "object"
    },
    "ProvenanceTransformation": {
      "additionalProperties": false,
      "description": "One reviewable transformation from declared inputs.",
      "properties": {
        "description": {
          "description": "Human-readable, independently written transformation summary.",
          "type": "string"
        },
        "id": {
          "description": "Stable transformation identifier.",
          "type": "string"
        },
        "inputs": {
          "description": "Sorted source or prior-transformation identifiers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inputs",
        "description"
      ],
      "type": "object"
    }
  },
  "$id": "urn:weave:schema:domain-pack:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One portable domain data pack.",
  "properties": {
    "dependencies": {
      "description": "Required packs in canonical identity order.",
      "items": {
        "$ref": "#/$defs/PackDependency"
      },
      "type": "array"
    },
    "id": {
      "description": "Stable pack identifier within its module.",
      "type": "string"
    },
    "module": {
      "$ref": "#/$defs/ModuleRequirement",
      "description": "Exact module identity plus an accepted semantic-version range."
    },
    "pack_format_version": {
      "const": 1,
      "description": "Data-pack format version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "Machine-readable source lineage for the data."
    },
    "title": {
      "description": "Human-readable pack title.",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "$ref": "#/$defs/DomainValue"
      },
      "description": "Initial values keyed by module export name.",
      "type": "object"
    },
    "version": {
      "description": "Semantic pack version.",
      "type": "string"
    }
  },
  "required": [
    "pack_format_version",
    "id",
    "version",
    "title",
    "module",
    "dependencies",
    "values",
    "provenance"
  ],
  "title": "Weave Domain Pack v1",
  "type": "object",
  "x-weave-domain-contract-version": 1
}
